<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= cls.name %> — Progress Grid</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: sans-serif; background: #f7f7f8; min-height: 100vh; }

    .topnav {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.6rem 1.25rem; background: #fff;
      border-bottom: 1px solid #e0e0e0; gap: 1rem;
    }
    .topnav-left { display: flex; align-items: center; gap: 1rem; }
    .topnav h1 { font-size: 1rem; font-weight: 700; }
    .badge { background: #27ae60; color: #fff; padding: 0.15rem 0.45rem; border-radius: 4px; font-size: 0.72rem; }
    .back-link { font-size: 0.85rem; color: #2980b9; text-decoration: none; }
    .back-link:hover { text-decoration: underline; }
    .topnav-right { font-size: 0.85rem; color: #555; }
    .topnav-right a { color: #555; text-decoration: none; }
    .topnav-right a:hover { text-decoration: underline; }

    .page { padding: 1.5rem; }
    .page-title { font-size: 1.1rem; font-weight: 700; margin-bottom: 0.25rem; }
    .page-sub { font-size: 0.85rem; color: #888; margin-bottom: 1.25rem; }

    /* ── Legend ── */
    .legend {
      display: flex; gap: 1rem; margin-bottom: 1.25rem; flex-wrap: wrap;
      font-size: 0.78rem;
    }
    .legend-item { display: flex; align-items: center; gap: 0.35rem; }
    .legend-dot {
      width: 12px; height: 12px; border-radius: 3px; flex-shrink: 0;
    }

    /* ── Grid wrapper ── */
    .grid-wrap { overflow-x: auto; }

    table { border-collapse: collapse; white-space: nowrap; }
    thead th {
      background: #f0f0f0;
      font-size: 0.72rem;
      font-weight: 700;
      color: #555;
      padding: 0.45rem 0.5rem;
      border: 1px solid #e0e0e0;
      text-align: center;
      min-width: 48px;
    }
    thead th.name-col { text-align: left; min-width: 160px; font-size: 0.78rem; }
    thead th.ext-col { color: #aaa; }
    thead th.divider-col {
      width: 8px; min-width: 8px; background: #e8e8e8; border: none; padding: 0;
    }

    tbody tr:hover td { filter: brightness(0.96); }
    tbody td {
      border: 1px solid #e8e8e8;
      padding: 0;
    }
    tbody td.name-cell {
      padding: 0.45rem 0.75rem;
      font-size: 0.88rem;
      font-weight: 500;
      background: #fff;
      position: sticky;
      left: 0;
      border-right: 2px solid #d0d0d0;
    }
    tbody td.divider-col { background: #e8e8e8; border: none; padding: 0; }

    /* ── State cells ── */
    .cell {
      display: block;
      width: 100%;
      height: 36px;
      border: none;
      cursor: pointer;
      font-size: 0.75rem;
      font-weight: 700;
      text-align: center;
      line-height: 36px;
    }
    .cell:focus-visible { outline: 2px solid #2980b9; outline-offset: -2px; }

    .cell-not-started { background: #f5f5f5; color: #ccc; cursor: default; }
    .cell-in-progress { background: #dbeafe; color: #1d4ed8; }
    .cell-in-progress:hover { background: #bfdbfe; }
    .cell-self-checked { background: #fef3c7; color: #92400e; }
    .cell-self-checked:hover { background: #fde68a; }
    .cell-confirmed    { background: #d1fae5; color: #065f46; }
    .cell-confirmed:hover { background: #a7f3d0; }

    .empty { color: #888; font-style: italic; padding: 2rem 0; }
  </style>
</head>
<body>
  <nav class="topnav">
    <div class="topnav-left">
      <h1>Newborn Swing <span class="badge">Teacher</span></h1>
      <a href="/classes/<%= cls.id %>" class="back-link">&#8592; <%= cls.name %></a>
    </div>
    <span class="topnav-right"><%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>

  <div class="page">
    <div class="page-title">Progress Grid — <%= cls.name %></div>
    <div class="page-sub">Click a cell to confirm it. Click a confirmed cell to revoke.</div>

    <div class="legend">
      <div class="legend-item"><div class="legend-dot" style="background:#f5f5f5;border:1px solid #ddd"></div> Not started</div>
      <div class="legend-item"><div class="legend-dot" style="background:#dbeafe"></div> In progress</div>
      <div class="legend-item"><div class="legend-dot" style="background:#fef3c7"></div> Self-checked</div>
      <div class="legend-item"><div class="legend-dot" style="background:#d1fae5"></div> Confirmed</div>
    </div>

    <% if (students.length === 0) { %>
      <p class="empty">No students in this class yet. <a href="/classes/<%= cls.id %>">Add students</a> first.</p>
    <% } else { %>
      <%
        const mainTrack  = checkpoints.filter(cp => cp.ordinal <= 8);
        const extension  = checkpoints.filter(cp => cp.ordinal > 8);
      %>
      <div class="grid-wrap">
        <table id="grid">
          <thead>
            <tr>
              <th class="name-col">Student</th>
              <% for (const cp of mainTrack) { %>
                <th title="<%= cp.title %>"><%= cp.code %></th>
              <% } %>
              <th class="divider-col"></th>
              <% for (const cp of extension) { %>
                <th class="ext-col" title="<%= cp.title %>"><%= cp.code %></th>
              <% } %>
            </tr>
          </thead>
          <tbody>
            <% for (const student of students) { %>
              <tr>
                <td class="name-cell"><%= student.name %></td>
                <% for (const cp of mainTrack) { %>
                  <%
                    const state = progressMap[student.id][cp.code] || 'not_started';
                  %>
                  <td>
                    <% if (state === 'not_started') { %>
                      <span class="cell cell-not-started" title="Not started">—</span>
                    <% } else { %>
                      <button
                        class="cell cell-<%= state.replace('_','-') %>"
                        data-student="<%= student.id %>"
                        data-code="<%= cp.code %>"
                        data-state="<%= state %>"
                        onclick="toggleCell(this)"
                        title="<%= state.replace('_',' ') %>"
                      ><%= state === 'in_progress' ? '…' : '✓' %></button>
                    <% } %>
                  </td>
                <% } %>
                <td class="divider-col"></td>
                <% for (const cp of extension) { %>
                  <%
                    const state = progressMap[student.id][cp.code] || 'not_started';
                  %>
                  <td>
                    <% if (state === 'not_started') { %>
                      <span class="cell cell-not-started" title="Not started">—</span>
                    <% } else { %>
                      <button
                        class="cell cell-<%= state.replace('_','-') %>"
                        data-student="<%= student.id %>"
                        data-code="<%= cp.code %>"
                        data-state="<%= state %>"
                        onclick="toggleCell(this)"
                        title="<%= state.replace('_',' ') %>"
                      ><%= state === 'in_progress' ? '…' : '✓' %></button>
                    <% } %>
                  </td>
                <% } %>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>

  <script>
    async function toggleCell(btn) {
      const studentId = btn.dataset.student;
      const code      = btn.dataset.code;
      const curState  = btn.dataset.state;

      const newState = curState === 'confirmed' ? 'in_progress' : 'confirmed';

      btn.disabled = true;
      try {
        const res = await fetch(`/api/progress/${studentId}/${code}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ state: newState }),
        });
        if (!res.ok) throw new Error('Failed');

        btn.dataset.state = newState;
        btn.className = `cell cell-${newState.replace('_', '-')}`;
        btn.title = newState.replace('_', ' ');
        btn.textContent = newState === 'in_progress' ? '…' : '✓';
      } catch {
        alert('Could not update. Please try again.');
      } finally {
        btn.disabled = false;
      }
    }
  </script>
</body>
</html>
