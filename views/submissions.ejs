<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Submissions — <%= problem.title %></title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: sans-serif; max-width: 900px; margin: 40px auto; padding: 0 1rem; }
    nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    h1 { font-size: 1.4rem; margin: 0; }
    .badge { background: #27ae60; color: #fff; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
    .back { color: #555; text-decoration: none; font-size: 0.9rem; }
    .back:hover { color: #000; }
    h2 { font-size: 1.1rem; margin-bottom: 0.25rem; }
    .subtitle { color: #888; font-size: 0.85rem; margin-bottom: 1.5rem; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid #e0e0e0; vertical-align: top; }
    th { background: #f5f5f5; font-size: 0.85rem; color: #555; }
    .pass { color: #1e8449; font-weight: 600; }
    .fail { color: #c0392b; font-weight: 600; }
    .empty { color: #888; padding: 2rem 0; text-align: center; }
    .view-link { font-size: 0.8rem; color: #2980b9; text-decoration: none; }
    .view-link:hover { text-decoration: underline; }
    .date { color: #888; font-size: 0.82rem; }
  </style>
</head>
<body>
  <nav>
    <h1>Newborn Swing <span class="badge">Teacher</span></h1>
    <span><%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>

  <a href="/dashboard" class="back">← Back to Dashboard</a>
  <h2 style="margin-top:1rem"><%= problem.title %> — Submissions</h2>
  <p class="subtitle"><%= submissions.length %> student<%= submissions.length !== 1 ? 's' : '' %> submitted</p>

  <% if (submissions.length === 0) { %>
    <p class="empty">No submissions yet.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Student</th>
          <th>Result</th>
          <th>Submitted</th>
          <th>Code</th>
        </tr>
      </thead>
      <tbody>
        <% submissions.forEach(s => { %>
          <% const allPass = s.passed_count === s.total_count; %>
          <tr>
            <td>
              <div><strong><%= s.name %></strong></div>
              <div style="font-size:0.8rem;color:#888"><%= s.email %></div>
            </td>
            <td class="<%= allPass ? 'pass' : 'fail' %>">
              <%= s.passed_count %>/<%= s.total_count %> passed
            </td>
            <td class="date"><%= new Date(s.created_at).toLocaleString() %></td>
            <td>
              <a href="/problems/<%= problem.id %>/submissions/<%= s.id %>" class="view-link">View code</a>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>


</body>
</html>
