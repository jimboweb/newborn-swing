<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Dashboard — Newborn Swing</title>
  <style>
    body { font-family: sans-serif; max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }
    nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; border-bottom: 1px solid #eee; padding-bottom: 1rem; }
    h1 { font-size: 1.25rem; margin: 0; }
    h2 { font-size: 1rem; margin-bottom: 1rem; color: #555; }
    .problem-list { list-style: none; }
    .problem-list li { margin-bottom: 0.75rem; }
    .problem-list a {
      display: block; padding: 1rem 1.25rem;
      border: 1px solid #ddd; border-radius: 6px;
      text-decoration: none; color: inherit;
      transition: border-color 0.15s, box-shadow 0.15s;
    }
    .problem-list a:hover { border-color: #0e639c; box-shadow: 0 0 0 3px rgba(14,99,156,0.1); }
    .problem-title { font-weight: 600; margin-bottom: 0.25rem; }
    .problem-desc { font-size: 0.85rem; color: #666; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .empty { color: #888; font-style: italic; }
    .problem-meta { display: flex; justify-content: space-between; align-items: flex-start; }
    .badge { font-size: 0.75rem; padding: 0.15rem 0.5rem; border-radius: 10px; white-space: nowrap; margin-left: 0.75rem; flex-shrink: 0; }
    .badge-pass { background: #d4edda; color: #155724; }
    .badge-fail { background: #f8d7da; color: #721c24; }
    .badge-none { background: #e9ecef; color: #6c757d; }
    .sequence-card { border: 1px solid #ddd; border-radius: 8px; margin-bottom: 1.25rem; overflow: hidden; }
    .sequence-header { background: #f8f4fd; padding: 0.75rem 1.25rem; border-bottom: 1px solid #ddd; }
    .sequence-title { font-weight: 700; font-size: 1rem; color: #5b2c8a; }
    .sequence-desc { font-size: 0.82rem; color: #888; margin-top: 0.15rem; }
    .seq-problem-list { list-style: none; margin: 0; padding: 0; }
    .seq-problem-list li { border-bottom: 1px solid #f0f0f0; }
    .seq-problem-list li:last-child { border-bottom: none; }
    .seq-problem-link { display: block; padding: 0.75rem 1.25rem; text-decoration: none; color: inherit; transition: background 0.1s; }
    .seq-problem-link:hover { background: #faf5ff; }
    .seq-problem-locked { display: flex; align-items: center; padding: 0.75rem 1.25rem; color: #aaa; cursor: default; }
    .lock-icon { margin-right: 0.6rem; font-size: 0.9rem; flex-shrink: 0; }
    .seq-problem-locked .problem-title { color: #bbb; }
    .seq-problem-locked .problem-desc { color: #ccc; }
  </style>
</head>
<body>
  <nav>
    <h1>Newborn Swing</h1>
    <span><%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>

  <% if (sequences.length > 0) { %>
    <h2>Problem Sequences</h2>
    <% sequences.forEach(seq => { %>
      <div class="sequence-card">
        <div class="sequence-header">
          <div class="sequence-title"><%= seq.title %></div>
          <% if (seq.description) { %><div class="sequence-desc"><%= seq.description %></div><% } %>
        </div>
        <ul class="seq-problem-list">
          <% seq.problems.forEach(p => { %>
            <li>
              <% if (p.unlocked) { %>
                <a href="/problems/<%= p.id %>" class="seq-problem-link">
                  <div class="problem-meta">
                    <div class="problem-title"><%= p.position %>. <%= p.title %></div>
                    <% if (p.total_count != null) { %>
                      <% const allPass = p.passed_count === p.total_count; %>
                      <span class="badge <%= allPass ? 'badge-pass' : 'badge-fail' %>">
                        <%= p.passed_count %>/<%= p.total_count %> passed
                      </span>
                    <% } else { %>
                      <span class="badge badge-none">Not attempted</span>
                    <% } %>
                  </div>
                  <div class="problem-desc"><%= p.description %></div>
                </a>
              <% } else { %>
                <div class="seq-problem-locked">
                  <span class="lock-icon">🔒</span>
                  <div>
                    <div class="problem-title"><%= p.position %>. <%= p.title %></div>
                    <div class="problem-desc">Complete the previous challenge to unlock</div>
                  </div>
                </div>
              <% } %>
            </li>
          <% }) %>
        </ul>
      </div>
    <% }) %>
  <% } %>

  <h2>Assigned Problems</h2>
  <% if (problems.length === 0) { %>
    <p class="empty">No problems assigned yet. Check back soon.</p>
  <% } else { %>
    <ul class="problem-list">
      <% problems.forEach(p => { %>
        <li>
          <a href="/problems/<%= p.id %>">
            <div class="problem-meta">
              <div class="problem-title"><%= p.title %></div>
              <% if (p.total_count != null) { %>
                <% const allPass = p.passed_count === p.total_count; %>
                <span class="badge <%= allPass ? 'badge-pass' : 'badge-fail' %>">
                  <%= p.passed_count %>/<%= p.total_count %> passed
                </span>
              <% } else { %>
                <span class="badge badge-none">Not attempted</span>
              <% } %>
            </div>
            <div class="problem-desc"><%= p.description %></div>
          </a>
        </li>
      <% }) %>
    </ul>
  <% } %>
</body>
</html>
