<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Newborn Swing</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: sans-serif; background: #f7f7f8; min-height: 100vh; }

    .topnav {
      display: flex; align-items: center; justify-content: space-between;
      padding: 0.65rem 1.5rem; background: #fff; border-bottom: 1px solid #e0e0e0;
    }
    .topnav h1 { font-size: 1rem; font-weight: 700; }
    .topnav-right { font-size: 0.85rem; color: #555; }
    .topnav-right a { color: #555; text-decoration: none; }
    .topnav-right a:hover { text-decoration: underline; }

    .page {
      max-width: 500px;
      margin: 5rem auto 2rem;
      padding: 0 1rem;
    }

    .project-tile {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1.75rem 1.75rem;
      margin-bottom: 0.85rem;
      background: #fff;
      border: 1px solid #dde1e7;
      border-radius: 10px;
      text-decoration: none;
      color: #111;
      font-size: 1.1rem;
      font-weight: 600;
      transition: border-color 0.15s, box-shadow 0.15s, background 0.15s;
    }
    .project-tile:hover {
      border-color: #2980b9;
      box-shadow: 0 2px 12px rgba(41,128,185,0.12);
      background: #fafcff;
    }
    .tile-arrow {
      font-size: 1.5rem;
      font-weight: 300;
      color: #bbb;
      flex-shrink: 0;
    }
    .project-tile:hover .tile-arrow { color: #2980b9; }
  </style>
</head>
<body>

  <nav class="topnav">
    <h1>Newborn Swing</h1>
    <span class="topnav-right"><%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>

  <div class="page">

    <a href="/cards" class="project-tile">
      Restaurant Website
      <span class="tile-arrow">›</span>
    </a>

    <% for (const seq of sequences) { %>
    <%   const first = seq.problems[0]; %>
    <a href="<%= first ? `/problems/${first.id}` : '#' %>" class="project-tile">
      <%= seq.title %>
      <span class="tile-arrow">›</span>
    </a>
    <% } %>

  </div>

</body>
</html>
