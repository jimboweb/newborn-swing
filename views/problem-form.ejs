<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Problem — Newborn Swing</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: sans-serif; max-width: 760px; margin: 40px auto; padding: 0 1rem; }
    nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    h1 { font-size: 1.4rem; margin: 0; }
    .badge { background: #27ae60; color: #fff; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
    label { display: block; font-weight: 600; margin-bottom: 0.3rem; font-size: 0.9rem; }
    input[type=text], textarea {
      width: 100%; padding: 0.5rem 0.6rem; border: 1px solid #ccc;
      border-radius: 4px; font-size: 0.95rem; font-family: inherit;
    }
    textarea { resize: vertical; }
    .field { margin-bottom: 1.25rem; }
    .test-case { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; margin-bottom: 0.75rem; position: relative; }
    .test-case-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
    .test-case-header span { font-weight: 600; font-size: 0.9rem; color: #444; }
    .remove-btn { background: none; border: none; color: #c0392b; cursor: pointer; font-size: 0.85rem; }
    .remove-btn:hover { text-decoration: underline; }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    .hidden-check { display: flex; align-items: center; gap: 0.4rem; margin-top: 0.5rem; font-size: 0.85rem; }
    .add-btn { background: none; border: 1px dashed #aaa; color: #555; padding: 0.4rem 0.9rem; border-radius: 4px; cursor: pointer; font-size: 0.85rem; margin-bottom: 1.5rem; }
    .add-btn:hover { border-color: #888; color: #333; }
    .actions { display: flex; gap: 0.75rem; align-items: center; }
    .btn { display: inline-block; padding: 0.5rem 1.2rem; border-radius: 4px; font-size: 0.95rem; cursor: pointer; border: none; text-decoration: none; }
    .btn-primary { background: #2980b9; color: #fff; }
    .btn-primary:hover { background: #2471a3; }
    .btn-cancel { color: #555; }
    .btn-cancel:hover { color: #000; }
    code { font-family: monospace; }
  </style>
</head>
<body>
  <nav>
    <h1>Newborn Swing <span class="badge">Teacher</span></h1>
    <span><%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>

  <h2>New Problem</h2>

  <form method="POST" action="/problems">
    <div class="field">
      <label for="title">Title</label>
      <input type="text" id="title" name="title" required placeholder="e.g. FizzBuzz">
    </div>

    <div class="field">
      <label for="description">Description</label>
      <textarea id="description" name="description" rows="5" required placeholder="Describe the problem. Include input/output format."></textarea>
    </div>

    <h3 style="margin-bottom:0.75rem">Test Cases</h3>
    <div id="test-cases"></div>

    <button type="button" class="add-btn" id="add-case">+ Add Test Case</button>

    <div class="actions">
      <button type="submit" class="btn btn-primary">Create Problem</button>
      <a href="/dashboard" class="btn btn-cancel">Cancel</a>
    </div>
  </form>

  <script>
    let count = 0;

    function addTestCase() {
      const i = count++;
      const div = document.createElement('div');
      div.className = 'test-case';
      div.innerHTML = `
        <div class="test-case-header">
          <span>Test Case ${i + 1}</span>
          <button type="button" class="remove-btn" onclick="this.closest('.test-case').remove()">Remove</button>
        </div>
        <div class="two-col">
          <div>
            <label>Input</label>
            <textarea name="inputs" rows="3" placeholder="stdin (leave blank if none)" style="font-family:monospace;font-size:0.85rem"></textarea>
          </div>
          <div>
            <label>Expected Output</label>
            <textarea name="expected_outputs" rows="3" placeholder="expected stdout" style="font-family:monospace;font-size:0.85rem"></textarea>
          </div>
        </div>
        <label class="hidden-check">
          <input type="checkbox" name="is_hidden" value="on"> Hidden from students
        </label>
      `;
      document.getElementById('test-cases').appendChild(div);
    }

    document.getElementById('add-case').addEventListener('click', addTestCase);
    addTestCase();
  </script>
</body>
</html>
