<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit <%= cp.code %> — Card Editor</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: sans-serif;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      background: #1e1e1e;
      color: #d4d4d4;
    }

    /* ── Header ── */
    .hdr {
      display: flex; align-items: center; gap: 0.75rem;
      padding: 0 0.9rem; height: 40px;
      background: #252526; border-bottom: 1px solid #3e3e3e; flex-shrink: 0;
    }
    .hdr-back {
      font-size: 0.82rem; color: #9e9e9e; text-decoration: none;
      border: 1px solid #3e3e3e; border-radius: 3px; padding: 0.2rem 0.55rem;
    }
    .hdr-back:hover { background: #3e3e3e; color: #d4d4d4; }
    .hdr-code { font-size: 0.75rem; font-weight: 700; color: #888; letter-spacing: 0.08em; }
    .hdr-title { flex: 1; font-size: 0.9rem; color: #ccc; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .hdr-status { font-size: 0.78rem; min-width: 6rem; text-align: right; color: #6a9955; }
    .hdr-status.unsaved { color: #e8a04a; }
    .hdr-status.saving  { color: #9e9e9e; }
    .hdr-status.error   { color: #f44747; }
    .save-btn {
      background: #0e639c; border: none; border-radius: 3px; color: #fff;
      font-size: 0.82rem; padding: 0.25rem 0.75rem; cursor: pointer;
    }
    .save-btn:hover { background: #1177bb; }
    .save-btn:disabled { opacity: 0.6; cursor: default; }

    /* ── Main split ── */
    .main { display: flex; flex: 1; overflow: hidden; }

    /* ── Edit pane ── */
    .edit-pane {
      width: 50%; display: flex; flex-direction: column;
      border-right: 1px solid #3e3e3e; overflow: hidden;
    }
    .fields {
      padding: 0.75rem 1rem; border-bottom: 1px solid #3e3e3e; flex-shrink: 0;
      display: flex; flex-direction: column; gap: 0.5rem;
    }
    .field-row { display: flex; align-items: center; gap: 0.5rem; }
    .field-label {
      font-size: 0.75rem; color: #888; white-space: nowrap; min-width: 5.5rem;
    }
    .field-input {
      flex: 1; background: #3c3c3c; border: 1px solid #555; border-radius: 3px;
      color: #d4d4d4; font-size: 0.85rem; padding: 0.3rem 0.5rem;
      font-family: inherit;
    }
    .field-input:focus { outline: none; border-color: #0e639c; }
    .field-hint { font-size: 0.7rem; color: #666; padding-left: 6rem; }

    .md-section { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
    .md-label {
      padding: 0.4rem 1rem 0.2rem; font-size: 0.72rem; color: #666;
      letter-spacing: 0.06em; text-transform: uppercase; flex-shrink: 0;
    }
    .md-textarea {
      flex: 1; resize: none; border: none; outline: none;
      background: #1e1e1e; color: #d4d4d4;
      font-family: 'Courier New', 'Consolas', monospace; font-size: 0.88rem;
      line-height: 1.6; padding: 0.5rem 1rem;
    }

    .starter-section { flex-shrink: 0; border-top: 1px solid #3e3e3e; }
    .starter-summary {
      padding: 0.4rem 1rem; font-size: 0.72rem; color: #666;
      letter-spacing: 0.06em; text-transform: uppercase; cursor: pointer;
      user-select: none;
    }
    .starter-summary:hover { color: #9e9e9e; }
    .starter-textarea {
      display: block; width: 100%; height: 120px; resize: none;
      border: none; border-top: 1px solid #3e3e3e; outline: none;
      background: #252526; color: #9cdcfe;
      font-family: 'Courier New', 'Consolas', monospace; font-size: 0.8rem;
      padding: 0.5rem 1rem;
    }

    /* ── Preview pane ── */
    .preview-pane {
      flex: 1; display: flex; flex-direction: column; overflow: hidden;
      background: #fff; color: #111;
    }
    .preview-header {
      padding: 0.4rem 1.25rem; font-size: 0.72rem; color: #888;
      letter-spacing: 0.07em; text-transform: uppercase;
      border-bottom: 1px solid #e8e8e8; background: #fafafa; flex-shrink: 0;
    }
    .preview-body {
      flex: 1; overflow-y: auto; padding: 1.25rem;
    }

    /* ── Video embed (preview + drawer) ── */
    .card-video {
      position: relative; padding-bottom: 56.25%; height: 0;
      margin-bottom: 1rem; border-radius: 6px; overflow: hidden;
      background: #000;
    }
    .card-video iframe {
      position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none;
    }
    .card-video-link {
      margin-bottom: 0.75rem;
    }
    .card-video-link a {
      display: inline-flex; align-items: center; gap: 0.4rem;
      color: #2980b9; text-decoration: none; font-size: 0.9rem; font-weight: 600;
      border: 1px solid #2980b9; border-radius: 4px; padding: 0.35rem 0.75rem;
    }
    .card-video-link a:hover { background: #f0f7ff; }

    /* ── Markdown styles (preview + drawer) ── */
    .card-md h2 { font-size: 1rem; font-weight: 700; margin: 1.25rem 0 0.5rem; color: #111; }
    .card-md h2:first-child { margin-top: 0; }
    .card-md h3 { font-size: 0.92rem; font-weight: 700; margin: 1rem 0 0.35rem; color: #333; }
    .card-md p  { font-size: 0.92rem; line-height: 1.6; color: #222; margin-bottom: 0.75rem; }
    .card-md ul, .card-md ol { padding-left: 1.4rem; margin-bottom: 0.75rem; }
    .card-md li { font-size: 0.92rem; line-height: 1.6; color: #222; margin-bottom: 0.25rem; }
    .card-md code { background: #f0f0f0; padding: 0.1em 0.35em; border-radius: 3px; font-size: 0.88em; font-family: monospace; color: #c7254e; }
    .card-md pre  { background: #f5f5f5; border: 1px solid #e0e0e0; border-radius: 4px; padding: 0.75rem 1rem; overflow-x: auto; margin-bottom: 0.75rem; }
    .card-md pre code { background: none; padding: 0; color: #222; font-size: 0.85rem; }
    .card-md strong { font-weight: 700; }
    .card-md blockquote { border-left: 3px solid #ccc; padding-left: 0.75rem; color: #555; margin-bottom: 0.75rem; }
    .card-md hr { border: none; border-top: 1px solid #e0e0e0; margin: 1rem 0; }
    .card-md img { max-width: 100%; border-radius: 4px; margin: 0.5rem 0; display: block; }
    .card-md a { color: #2980b9; }

    .preview-empty { color: #aaa; font-style: italic; font-size: 0.9rem; }
  </style>
</head>
<body>

  <header class="hdr">
    <a href="/cards" class="hdr-back">&#8592; Cards</a>
    <span class="hdr-code"><%= cp.code %></span>
    <span class="hdr-title"><%= cp.title %></span>
    <span class="hdr-status" id="status"></span>
    <button class="save-btn" id="save-btn" onclick="save()">Save</button>
  </header>

  <div class="main">

    <!-- Edit pane -->
    <div class="edit-pane">
      <div class="fields">
        <div class="field-row">
          <label class="field-label" for="video-url">Video URL</label>
          <input class="field-input" id="video-url" type="url"
            placeholder="https://www.youtube.com/watch?v=..."
            value="<%= cp.video_url || '' %>">
        </div>
        <div class="field-hint">YouTube or Vimeo URLs embed automatically. Other URLs show as a link.</div>
        <div class="field-row">
          <label class="field-label" for="keywords">Keywords</label>
          <input class="field-input" id="keywords" type="text"
            placeholder="html, css, restaurant, menu (comma-separated)"
            value="<%= Array.isArray(cp.keywords) ? cp.keywords.join(', ') : (cp.keywords || '') %>">
        </div>
      </div>

      <div class="md-section">
        <div class="md-label">Card content (Markdown) — images: ![alt](url)</div>
        <textarea class="md-textarea" id="body-md" spellcheck="true"><%= cp.body_md || '' %></textarea>
      </div>

      <details class="starter-section">
        <summary class="starter-summary">Starter files JSON (for "Try it" button) ▸</summary>
        <textarea class="starter-textarea" id="starter-json" spellcheck="false"><%= cp.starter_json ? JSON.stringify(cp.starter_json, null, 2) : '' %></textarea>
      </details>
    </div>

    <!-- Preview pane -->
    <div class="preview-pane">
      <div class="preview-header">Preview</div>
      <div class="preview-body" id="preview-body">
        <p class="preview-empty">Start typing to see a preview.</p>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/marked@9/marked.min.js"></script>
  <script>
    marked.use({ renderer: { html(t) { return (t.raw||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); } } });

    const bodyInput    = document.getElementById('body-md');
    const videoInput   = document.getElementById('video-url');
    const keywordsInput= document.getElementById('keywords');
    const starterInput = document.getElementById('starter-json');
    const previewEl    = document.getElementById('preview-body');
    const statusEl     = document.getElementById('status');
    const saveBtn      = document.getElementById('save-btn');

    let dirty = false;
    let previewTimer = null;

    function setStatus(s) {
      statusEl.className = 'hdr-status' + (s === 'unsaved' ? ' unsaved' : s === 'saving' ? ' saving' : s === 'error' ? ' error' : '');
      statusEl.textContent = { unsaved: 'Unsaved changes', saving: 'Saving…', saved: 'Saved ✓', error: 'Save failed' }[s] || '';
    }

    function markDirty() {
      dirty = true;
      setStatus('unsaved');
    }

    function toEmbedUrl(url) {
      if (!url || !url.trim()) return null;
      url = url.trim();
      let m = url.match(/[?&]v=([a-zA-Z0-9_-]{11})/);
      if (m) return `https://www.youtube.com/embed/${m[1]}`;
      m = url.match(/youtu\.be\/([a-zA-Z0-9_-]{11})/);
      if (m) return `https://www.youtube.com/embed/${m[1]}`;
      if (/youtube\.com\/embed\//.test(url)) return url;
      m = url.match(/vimeo\.com\/(\d+)/);
      if (m) return `https://player.vimeo.com/video/${m[1]}`;
      if (/player\.vimeo\.com\/video\//.test(url)) return url;
      return null;
    }

    function buildPreview() {
      const md  = bodyInput.value;
      const vid = videoInput.value.trim();
      let html = '';

      if (vid) {
        const embed = toEmbedUrl(vid);
        if (embed) {
          html += `<div class="card-video"><iframe src="${embed}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>`;
        } else {
          html += `<div class="card-video-link"><a href="${vid}" target="_blank" rel="noopener">&#9654; Watch video</a></div>`;
        }
      }

      if (md.trim()) {
        html += `<div class="card-md">${marked.parse(md)}</div>`;
      }

      previewEl.innerHTML = html || '<p class="preview-empty">Start typing to see a preview.</p>';
    }

    function schedulePreview() {
      if (previewTimer) clearTimeout(previewTimer);
      previewTimer = setTimeout(buildPreview, 300);
    }

    bodyInput.addEventListener('input', () => { markDirty(); schedulePreview(); });
    videoInput.addEventListener('input', () => { markDirty(); schedulePreview(); });
    keywordsInput.addEventListener('input', markDirty);
    starterInput.addEventListener('input', markDirty);

    async function save() {
      setStatus('saving');
      saveBtn.disabled = true;
      try {
        const res = await fetch(`/admin/cards/<%= cp.code %>`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            body_md:      bodyInput.value,
            video_url:    videoInput.value.trim() || null,
            keywords:     keywordsInput.value,
            starter_json: starterInput.value.trim() || null,
          }),
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Save failed');
        dirty = false;
        setStatus('saved');
        setTimeout(() => { if (!dirty) setStatus(''); }, 3000);
      } catch (err) {
        setStatus('error');
        alert(err.message || 'Save failed. Please try again.');
      } finally {
        saveBtn.disabled = false;
      }
    }

    // Ctrl+S / Cmd+S
    document.addEventListener('keydown', e => {
      if ((e.ctrlKey || e.metaKey) && e.key === 's') {
        e.preventDefault();
        save();
      }
    });

    // Warn before leaving with unsaved changes
    window.addEventListener('beforeunload', e => {
      if (dirty) { e.preventDefault(); e.returnValue = ''; }
    });

    // Initial preview
    buildPreview();
  </script>
</body>
</html>
