<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= problem.title %> — Spec Mode</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: sans-serif; max-width: 820px; margin: 0 auto 3rem; padding: 0 1rem; color: #222; }
    nav { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; margin-bottom: 1rem; }
    nav h1 { font-size: 1.1rem; }
    nav a { color: #555; text-decoration: none; font-size: 0.85rem; }
    h2 { font-size: 1.3rem; margin-bottom: 0.25rem; }
    .desc { color: #555; margin-bottom: 1.5rem; white-space: pre-wrap; }
    section { border: 1px solid #e0e0e0; border-radius: 8px; padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; background: #fff; }
    section h3 { font-size: 1.05rem; margin-bottom: 1rem; }
    .badge { display: inline-block; padding: 0.2rem 0.6rem; border-radius: 12px; font-size: 0.75rem; font-weight: 700; margin-bottom: 1rem; }
    .badge-needs_revision { background: #fee2e2; color: #991b1b; }
    .badge-awaiting_approval { background: #fef3c7; color: #92400e; }
    .badge-shared { background: #d1fae5; color: #065f46; }
    .feedback-list { list-style: none; margin-bottom: 1rem; }
    .feedback-list li { padding: 0.5rem 0.75rem; border-radius: 5px; margin-bottom: 0.4rem; font-size: 0.85rem; font-family: monospace; }
    .feedback-pass { background: #ecfdf5; color: #065f46; }
    .feedback-fail { background: #fef2f2; color: #991b1b; }
    .teacher-comment { background: #fff7ed; border: 1px solid #fdba74; border-radius: 5px; padding: 0.6rem 0.9rem; font-size: 0.88rem; color: #9a3412; margin-bottom: 1rem; white-space: pre-wrap; }
    label { display: block; font-weight: 600; margin-bottom: 0.3rem; font-size: 0.88rem; }
    textarea, input[type=text] { width: 100%; padding: 0.5rem 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem; font-family: inherit; }
    .field { margin-bottom: 1rem; }
    .case-row { border: 1px solid #ddd; border-radius: 6px; padding: 0.85rem 1rem; margin-bottom: 0.6rem; }
    .case-row-head { display: flex; justify-content: space-between; margin-bottom: 0.5rem; }
    .case-row-head span { font-weight: 600; font-size: 0.85rem; color: #444; }
    .remove-btn { background: none; border: none; color: #c0392b; cursor: pointer; font-size: 0.82rem; }
    .param-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 0.6rem; margin-bottom: 0.6rem; }
    .param-grid label { font-size: 0.78rem; font-weight: 500; color: #666; }
    .param-grid input { font-family: monospace; font-size: 0.85rem; }
    .expect-row { display: flex; align-items: flex-start; gap: 1.25rem; font-size: 0.85rem; }
    .expect-row label { display: flex; align-items: center; gap: 0.35rem; font-weight: 400; margin: 0; white-space: nowrap; }
    .expect-row input[type=text] { width: 160px; font-family: monospace; }
    .add-btn { background: none; border: 1px dashed #aaa; color: #555; padding: 0.4rem 0.9rem; border-radius: 4px; cursor: pointer; font-size: 0.85rem; margin: 0.5rem 0 1.25rem; }

    /* ── Value editor: a plain value, or a List/Dictionary built from rows
       instead of typed syntax (see createValueEditor() below) ── */
    .value-editor { display: flex; flex-direction: column; gap: 0.3rem; min-width: 150px; }
    .value-editor .value-kind { width: auto; align-self: flex-start; font-size: 0.76rem; padding: 0.15rem 0.3rem; border: 1px solid #ccc; border-radius: 3px; }
    .value-list-box, .value-dict-box { border: 1px dashed #bbb; border-radius: 4px; padding: 0.4rem 0.5rem; background: #fafafa; }
    .value-item-row, .value-entry-row { display: flex; gap: 0.4rem; align-items: center; margin-bottom: 0.3rem; }
    .value-item-row:last-child, .value-entry-row:last-child { margin-bottom: 0; }
    .value-item-row input, .value-entry-row input { width: auto; flex: 1; font-family: monospace; font-size: 0.8rem; }
    .value-entry-row input.value-key { flex: 0 0 90px; }
    .value-editor .add-btn { margin: 0; padding: 0.2rem 0.5rem; font-size: 0.75rem; }
    .value-item-row .remove-btn, .value-entry-row .remove-btn { font-size: 0.72rem; }
    .btn { display: inline-block; padding: 0.5rem 1.2rem; border-radius: 4px; font-size: 0.9rem; cursor: pointer; border: none; }
    .btn-primary { background: #2980b9; color: #fff; }
    pre.docstring { background: #1e1e1e; color: #d4d4d4; padding: 1rem 1.25rem; border-radius: 6px; overflow-x: auto; font-size: 0.85rem; margin-bottom: 1rem; }
    .placeholder { color: #888; font-style: italic; padding: 1rem 0; }
  </style>
</head>
<body>
  <nav>
    <h1>Newborn Swing</h1>
    <span><a href="/dashboard">&#8592; Dashboard</a> &nbsp;|&nbsp; <%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>

  <h2><%= problem.title %></h2>
  <div class="desc"><%= problem.description %></div>

  <section>
    <h3>Your specification</h3>

    <% if (spec) { %>
      <span class="badge badge-<%= spec.status %>">
        <%= spec.status === 'needs_revision' ? 'Needs revision' : spec.status === 'awaiting_approval' ? 'Awaiting teacher approval' : 'Shared' %>
      </span>

      <% if (spec.teacher_comment) { %>
        <div class="teacher-comment"><strong>Teacher feedback:</strong><br><%= spec.teacher_comment %></div>
      <% } %>

      <% if (spec.auto_check_details && spec.auto_check_details.length) { %>
        <ul class="feedback-list">
          <% spec.auto_check_details.forEach(d => { %>
            <li class="<%= d.passed ? 'feedback-pass' : 'feedback-fail' %>">
              <%= d.passed ? '✓' : '✗' %> <%= d.message || 'Passed' %>
            </li>
          <% }) %>
        </ul>
      <% } %>
    <% } %>

    <form method="POST" action="/spec/problems/<%= problem.id %>/specs">
      <div class="field">
        <label for="description_text">Describe the general rule</label>
        <textarea id="description_text" name="description_text" rows="4"
          placeholder="e.g. Calculates change owed... if payment is less than price, the payment is insufficient and should be treated as an error."
        ><%= spec ? spec.description_text : '' %></textarea>
      </div>

      <label>Examples <span style="font-weight:400;color:#888">(minimum <%= problem.min_examples || 1 %>)</span></label>
      <div id="cases"></div>
      <button type="button" class="add-btn" id="add-case">+ Add example</button>

      <div>
        <button type="submit" class="btn btn-primary">Submit specification</button>
      </div>
    </form>
  </section>

  <section>
    <h3>Your assignment</h3>
    <% if (!assignment) { %>
      <p class="placeholder">Waiting on a partner's spec — check back after your teacher generates a round.</p>
    <% } else { %>
      <p style="margin-bottom:0.75rem;color:#555;font-size:0.9rem">Implement this specification, written by <strong><%= assignment.authoredSpec.author_name %></strong>:</p>
      <pre class="docstring"><%= assignment.docstring %></pre>

      <% if (assignment.implementation && assignment.implementation.test_result) { %>
        <% const tr = assignment.implementation.test_result; %>
        <p style="font-size:0.88rem;margin-bottom:0.5rem"><strong><%= tr.passed %> / <%= tr.total %></strong> cases passed</p>
        <ul class="feedback-list">
          <% tr.details.forEach(d => { %>
            <li class="<%= d.passed ? 'feedback-pass' : 'feedback-fail' %>">
              <%= d.passed ? '✓' : '✗' %> <%= d.message || 'Passed' %>
            </li>
          <% }) %>
        </ul>
      <% } %>

      <form method="POST" action="/spec/problems/<%= problem.id %>/implement">
        <div class="field">
          <label for="code_text">Your implementation</label>
          <textarea id="code_text" name="code_text" rows="10" style="font-family:monospace;font-size:0.88rem"
          ><%= assignment.implementation ? assignment.implementation.code_text : `def ${problem.function_name}(${problem.param_names.join(', ')}):\n    ` %></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Submit implementation</button>
      </form>
    <% } %>
  </section>

  <script>
    const paramNames = <%- JSON.stringify(problem.param_names) %>;
    const existingCases = <%- JSON.stringify(specTestCases) %>;

    // Each row's two radios need a name unique to that row (radios with the
    // same name are mutually exclusive across the WHOLE page, not per row),
    // but names must also stay contiguous 0..N-1 in DOM order so the server
    // can line them up with the param input arrays after rows are removed —
    // so every add/remove renumbers all rows by their current DOM position.
    function renumberCases() {
      const rows = document.querySelectorAll('#cases .case-row');
      rows.forEach((row, i) => {
        row.querySelector('.case-row-head span').textContent = `Example ${i + 1}`;
        row.querySelectorAll('input[type=radio]').forEach(r => { r.name = `expect_type_${i}`; });
      });
    }

    // ── Value editor: lets a parameter or a return value be a List or a
    // Dictionary, built from rows instead of typed bracket/JSON syntax —
    // same "no syntax" principle as coerceValue() server-side. One level
    // deep (a list/dict of plain values, not nested lists-of-lists): that
    // covers checking the state of a returned list or dict without asking
    // a student to nest structures inside a text box.
    function scalarToText(v) {
      if (v === null || v === undefined) return '';
      if (typeof v === 'boolean') return v ? 'true' : 'false';
      return String(v);
    }

    // Client-side mirror of coerceValue() in routes/specmode.js — used only
    // to turn each item/entry's typed text into the right JS type before
    // folding the whole list/dict into real JSON (the server re-parses the
    // result with its own copy, so this one is never trusted alone).
    function coerceValueClient(raw) {
      const s = String(raw ?? '').trim();
      if (s === '') return null;
      if (s === 'true') return true;
      if (s === 'false') return false;
      if (/^-?\d+$/.test(s)) return parseInt(s, 10);
      if (/^-?\d+\.\d+$/.test(s)) return parseFloat(s);
      if ((s.startsWith('"') && s.endsWith('"')) || (s.startsWith("'") && s.endsWith("'"))) {
        return s.slice(1, -1);
      }
      return s;
    }

    function createValueEditor(name, initialValue) {
      const root = document.createElement('div');
      root.className = 'value-editor';

      const realInput = document.createElement('input');
      realInput.type = 'text';
      realInput.name = name;
      realInput.placeholder = 'e.g. 3 or "red" or true';

      const kindSelect = document.createElement('select');
      kindSelect.className = 'value-kind';
      kindSelect.innerHTML = `<option value="simple">Value</option><option value="list">List</option><option value="dict">Dictionary</option>`;

      const listBox = document.createElement('div');
      listBox.className = 'value-list-box';
      const listItems = document.createElement('div');
      listBox.appendChild(listItems);
      const addItemBtn = document.createElement('button');
      addItemBtn.type = 'button'; addItemBtn.className = 'add-btn'; addItemBtn.textContent = '+ Add item';
      addItemBtn.addEventListener('click', () => addListItem(''));
      listBox.appendChild(addItemBtn);

      const dictBox = document.createElement('div');
      dictBox.className = 'value-dict-box';
      const dictEntries = document.createElement('div');
      dictBox.appendChild(dictEntries);
      const addEntryBtn = document.createElement('button');
      addEntryBtn.type = 'button'; addEntryBtn.className = 'add-btn'; addEntryBtn.textContent = '+ Add entry';
      addEntryBtn.addEventListener('click', () => addDictEntry('', ''));
      dictBox.appendChild(addEntryBtn);

      function addListItem(v) {
        const row = document.createElement('div');
        row.className = 'value-item-row';
        const input = document.createElement('input');
        input.type = 'text'; input.value = scalarToText(v); input.placeholder = 'e.g. 3 or "red" or true';
        const del = document.createElement('button');
        del.type = 'button'; del.className = 'remove-btn'; del.textContent = 'Remove';
        del.addEventListener('click', () => row.remove());
        row.append(input, del);
        listItems.appendChild(row);
      }

      function addDictEntry(k, v) {
        const row = document.createElement('div');
        row.className = 'value-entry-row';
        const keyInput = document.createElement('input');
        keyInput.type = 'text'; keyInput.className = 'value-key'; keyInput.value = k ?? ''; keyInput.placeholder = 'key';
        const valInput = document.createElement('input');
        valInput.type = 'text'; valInput.value = scalarToText(v); valInput.placeholder = 'e.g. 3 or "red" or true';
        const del = document.createElement('button');
        del.type = 'button'; del.className = 'remove-btn'; del.textContent = 'Remove';
        del.addEventListener('click', () => row.remove());
        row.append(keyInput, valInput, del);
        dictEntries.appendChild(row);
      }

      function setKind(kind) {
        kindSelect.value = kind;
        realInput.hidden = kind !== 'simple';
        listBox.hidden = kind !== 'list';
        dictBox.hidden = kind !== 'dict';
      }
      kindSelect.addEventListener('change', () => setKind(kindSelect.value));

      // Detect the initial kind from the stored value: a real array/object
      // coming back from the database, or a plain scalar.
      if (Array.isArray(initialValue)) {
        initialValue.forEach(addListItem);
        if (!initialValue.length) addListItem('');
        setKind('list');
      } else if (initialValue && typeof initialValue === 'object') {
        Object.entries(initialValue).forEach(([k, v]) => addDictEntry(k, v));
        if (!Object.keys(initialValue).length) addDictEntry('', '');
        setKind('dict');
      } else {
        realInput.value = scalarToText(initialValue);
        setKind('simple');
      }

      root.append(kindSelect, realInput, listBox, dictBox);

      // Called right before the form submits: folds the repeater's rows
      // back into the one real <input> that actually gets posted, as JSON
      // text. coerceValue() on the server recognizes a leading [ or { and
      // parses it as real JSON instead of a plain scalar — every value
      // typed into the plain "Value" field is untouched, so existing
      // simple examples keep working exactly as before.
      root.sync = function () {
        if (kindSelect.value === 'list') {
          const items = [...listItems.querySelectorAll('input')].map(i => coerceValueClient(i.value));
          realInput.value = JSON.stringify(items);
        } else if (kindSelect.value === 'dict') {
          const obj = {};
          dictEntries.querySelectorAll('.value-entry-row').forEach(row => {
            const [keyInput, valInput] = row.querySelectorAll('input');
            const key = keyInput.value.trim();
            if (key) obj[key] = coerceValueClient(valInput.value);
          });
          realInput.value = JSON.stringify(obj);
        }
      };

      return root;
    }

    function addCase(inputs = {}, expectType = 'returns', expectedValue = '') {
      const div = document.createElement('div');
      div.className = 'case-row';
      const paramFields = paramNames.map(p => `
        <div>
          <label>${p}</label>
          <span class="param-value-slot" data-param="${p}"></span>
        </div>
      `).join('');
      div.innerHTML = `
        <div class="case-row-head">
          <span>Example</span>
          <button type="button" class="remove-btn" onclick="this.closest('.case-row').remove(); renumberCases();">Remove</button>
        </div>
        <div class="param-grid">${paramFields}</div>
        <div class="expect-row">
          <label><input type="radio" value="returns" ${expectType !== 'raises' ? 'checked' : ''}> Returns:</label>
          <span class="expected-value-slot"></span>
          <label><input type="radio" value="raises" ${expectType === 'raises' ? 'checked' : ''}> Should cause an error</label>
        </div>
      `;

      paramNames.forEach(p => {
        const slot = div.querySelector(`.param-value-slot[data-param="${p}"]`);
        slot.replaceWith(createValueEditor(`input_${p}`, inputs[p] ?? ''));
      });

      const expectedEditor = createValueEditor('expected_value', expectedValue ?? '');
      expectedEditor.hidden = expectType === 'raises';
      div.querySelector('.expected-value-slot').replaceWith(expectedEditor);

      div.querySelectorAll('input[type=radio]').forEach(r => {
        r.addEventListener('change', () => {
          expectedEditor.hidden = div.querySelector('input[type=radio][value=raises]').checked;
        });
      });

      document.getElementById('cases').appendChild(div);
      renumberCases();
    }

    document.getElementById('add-case').addEventListener('click', () => addCase());

    if (existingCases.length > 0) {
      existingCases.forEach(c => addCase(c.inputs, c.expect_type, c.expected_value));
    } else {
      addCase();
    }

    // Fold every value editor's current rows into its real <input> right
    // before the browser collects the form fields to submit.
    document.querySelector('form[action$="/specs"]').addEventListener('submit', () => {
      document.querySelectorAll('.value-editor').forEach(el => el.sync && el.sync());
    });
  </script>
</body>
</html>
