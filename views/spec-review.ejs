<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= problem.title %> — Review Specs</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: sans-serif; max-width: 900px; margin: 0 auto 3rem; padding: 0 1rem; color: #222; }
    nav { display: flex; justify-content: space-between; align-items: center; padding: 1rem 0; margin-bottom: 1rem; }
    nav h1 { font-size: 1.1rem; }
    nav a { color: #555; text-decoration: none; font-size: 0.85rem; }
    .badge { background: #7d3c98; color: #fff; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
    h2 { font-size: 1.3rem; margin-bottom: 1.25rem; }
    section { border: 1px solid #e0e0e0; border-radius: 8px; padding: 1.25rem 1.5rem; margin-bottom: 1.5rem; background: #fff; }
    section h3 { font-size: 1.05rem; margin-bottom: 1rem; }
    table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
    th, td { text-align: left; padding: 0.5rem 0.6rem; border-bottom: 1px solid #eee; vertical-align: top; }
    th { color: #666; font-size: 0.78rem; text-transform: uppercase; }
    .empty { color: #888; font-style: italic; }
    .desc-preview { color: #444; max-width: 320px; white-space: pre-wrap; }
    details summary { cursor: pointer; color: #2980b9; font-size: 0.82rem; }
    .case-line { font-family: monospace; font-size: 0.8rem; padding: 0.15rem 0; }
    textarea { width: 100%; padding: 0.5rem 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-family: inherit; font-size: 0.88rem; }
    .btn { padding: 0.45rem 1rem; border-radius: 4px; font-size: 0.85rem; cursor: pointer; border: none; margin-right: 0.5rem; }
    .btn-approve { background: #059669; color: #fff; }
    .btn-reject { background: #dc2626; color: #fff; }
    .btn-generate { background: #2980b9; color: #fff; }
    .btn-generate:disabled { background: #aaa; cursor: default; }
    .status-pill { display: inline-block; padding: 0.1rem 0.5rem; border-radius: 10px; font-size: 0.72rem; font-weight: 700; }
    .status-pass { background: #d1fae5; color: #065f46; }
    .status-pending { background: #f0f0f0; color: #888; }
  </style>
</head>
<body>
  <nav>
    <h1>Newborn Swing <span class="badge">Teacher</span></h1>
    <span><a href="/dashboard">&#8592; Dashboard</a> &nbsp;|&nbsp; <%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>

  <h2><%= problem.title %> — spec review</h2>

  <section>
    <h3>Awaiting approval (<%= awaiting.length %>)</h3>
    <% if (!awaiting.length) { %>
      <p class="empty">Nothing waiting on you right now.</p>
    <% } else { %>
      <form method="POST" action="/spec/problems/<%= problem.id %>/review" id="review-form">
        <table>
          <thead>
            <tr>
              <th><input type="checkbox" id="select-all"></th>
              <th>Student</th>
              <th>Description</th>
              <th>Examples</th>
            </tr>
          </thead>
          <tbody>
            <% awaiting.forEach(sp => { %>
              <tr>
                <td><input type="checkbox" name="spec_ids" value="<%= sp.id %>" class="row-check"></td>
                <td><%= sp.student_name %><br><span style="color:#999;font-size:0.78rem"><%= sp.student_email %></span></td>
                <td class="desc-preview"><%= sp.description_text %></td>
                <td>
                  <%= sp.case_count %>
                  <details>
                    <summary>view</summary>
                    <% (sp.auto_check_details || []).forEach(d => { %>
                      <div class="case-line"><%= JSON.stringify(d.inputs) %> &#8594; <%= d.expect_type === 'raises' ? 'error' : JSON.stringify(d.expected_value) %></div>
                    <% }) %>
                  </details>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>

        <div style="margin:1rem 0">
          <label style="font-size:0.85rem;font-weight:600;display:block;margin-bottom:0.3rem">Comment (shown to student if rejecting)</label>
          <textarea name="comment" rows="2" placeholder="e.g. Your examples are all nearly identical — add one that tests exact-change."></textarea>
        </div>

        <button type="submit" name="action" value="approve" class="btn btn-approve">Approve selected</button>
        <button type="submit" name="action" value="reject" class="btn btn-reject">Reject selected</button>
      </form>
    <% } %>
  </section>

  <section>
    <h3>Pairings</h3>
    <p style="font-size:0.88rem;color:#555;margin-bottom:0.75rem"><%= sharedCount %> spec<%= sharedCount === 1 ? '' : 's' %> currently shared and eligible for pairing.</p>
    <form method="POST" action="/spec/problems/<%= problem.id %>/pairings/generate">
      <button type="submit" class="btn btn-generate" <%= sharedCount < 2 ? 'disabled' : '' %>>Generate a round</button>
    </form>

    <% if (pairings.length) { %>
      <table style="margin-top:1.25rem">
        <thead>
          <tr><th>Round</th><th>Spec author</th><th>Implementer</th><th>Status</th></tr>
        </thead>
        <tbody>
          <% pairings.forEach(pr => { %>
            <tr>
              <td><%= pr.round %></td>
              <td><%= pr.author_name %></td>
              <td><%= pr.implementer_name %></td>
              <td>
                <% if (pr.test_result) { %>
                  <span class="status-pill status-pass"><%= pr.test_result.passed %>/<%= pr.test_result.total %> passed</span>
                <% } else { %>
                  <span class="status-pill status-pending">not submitted</span>
                <% } %>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } %>
  </section>

  <script>
    document.getElementById('select-all')?.addEventListener('change', function () {
      document.querySelectorAll('.row-check').forEach(cb => cb.checked = this.checked);
    });
  </script>
</body>
</html>
