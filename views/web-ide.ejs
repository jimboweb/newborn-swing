<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= project.title %> — Newborn Swing</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      display: flex;
      flex-direction: column;
      height: 100dvh;
      overflow: hidden;
      font-family: sans-serif;
      background: #1e1e1e;
      color: #d4d4d4;
    }

    /* ── Header ── */
    .ide-header {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0 0.75rem;
      height: 40px;
      background: #252526;
      border-bottom: 1px solid #3e3e3e;
      flex-shrink: 0;
    }
    .hdr-back {
      text-decoration: none;
      color: #9e9e9e;
      font-size: 0.82rem;
      border: 1px solid #3e3e3e;
      border-radius: 3px;
      padding: 0.2rem 0.55rem;
      white-space: nowrap;
    }
    .hdr-back:hover { background: #3e3e3e; color: #d4d4d4; }
    .hdr-title {
      flex: 1;
      font-size: 0.88rem;
      color: #cccccc;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .hdr-save {
      font-size: 0.75rem;
      color: #6a9955;
      min-width: 4rem;
      text-align: right;
      white-space: nowrap;
    }
    .hdr-save.saving { color: #9e9e9e; }
    .hdr-save.error  { color: #f44747; }
    .hdr-btn {
      background: none;
      border: 1px solid #3e3e3e;
      border-radius: 3px;
      color: #d4d4d4;
      font-size: 0.82rem;
      padding: 0.2rem 0.6rem;
      cursor: pointer;
      white-space: nowrap;
    }
    .hdr-btn:hover { background: #3e3e3e; }
    .hdr-btn-run { background: #0e639c; border-color: #0e639c; color: #fff; }
    .hdr-btn-run:hover { background: #1177bb; border-color: #1177bb; }

    /* ── Tab bar ── */
    .ide-tabs {
      display: flex;
      align-items: center;
      background: #2d2d2d;
      border-bottom: 1px solid #3e3e3e;
      flex-shrink: 0;
      overflow-x: auto;
      scrollbar-width: thin;
      scrollbar-color: #555 transparent;
    }
    .file-tab {
      display: flex;
      align-items: center;
      gap: 0.3rem;
      padding: 0 0.75rem;
      height: 34px;
      font-size: 0.82rem;
      color: #9e9e9e;
      background: none;
      border: none;
      border-right: 1px solid #3e3e3e;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .file-tab:hover { background: #3e3e3e; color: #d4d4d4; }
    .file-tab.active { background: #1e1e1e; color: #d4d4d4; border-bottom: 2px solid #0e639c; }
    .tab-del {
      font-size: 0.95rem;
      color: #666;
      padding: 0 2px;
      border-radius: 2px;
      line-height: 1;
      display: none;
    }
    .file-tab:hover .tab-del,
    .file-tab.active .tab-del { display: inline; }
    .tab-del:hover { color: #f44747; background: rgba(244,71,71,0.15); }
    .tab-new {
      padding: 0 0.75rem;
      height: 34px;
      font-size: 0.8rem;
      color: #6a9955;
      background: none;
      border: none;
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .tab-new:hover { color: #9cdcfe; }

    /* ── Main IDE area ── */
    .ide-main {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    /* ── Card drawer (same logic as cards page) ── */
    .card-drawer {
      width: 0;
      overflow: hidden;
      background: #252526;
      border-right: 1px solid #3e3e3e;
      flex-shrink: 0;
      transition: width 0.22s ease;
      display: flex;
      flex-direction: column;
    }
    .card-drawer.open { width: 380px; }
    .drawer-inner {
      width: 380px;
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .drawer-header {
      display: flex;
      align-items: flex-start;
      gap: 0.5rem;
      padding: 0.75rem 1rem 0.6rem;
      border-bottom: 1px solid #3e3e3e;
      flex-shrink: 0;
    }
    .drawer-header-text { flex: 1; min-width: 0; }
    .drawer-code { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.1em; color: #9e9e9e; text-transform: uppercase; margin-bottom: 0.15rem; }
    .drawer-title { font-size: 0.95rem; font-weight: 700; color: #d4d4d4; }
    .drawer-close {
      background: none; border: 1px solid #3e3e3e; border-radius: 3px;
      color: #9e9e9e; cursor: pointer; font-size: 1rem; padding: 0 6px; height: 24px;
    }
    .drawer-close:hover { background: #3e3e3e; }
    .drawer-body {
      flex: 1;
      overflow-y: auto;
      padding: 1rem;
      scrollbar-width: thin;
      scrollbar-color: #555 transparent;
    }
    .drawer-loading { color: #9e9e9e; font-size: 0.85rem; }
    .drawer-error   { color: #f44747; font-size: 0.85rem; }

    /* Markdown inside drawer (dark theme) */
    .card-md h2 { font-size: 0.92rem; font-weight: 700; color: #d4d4d4; margin: 1.1rem 0 0.4rem; }
    .card-md h2:first-child { margin-top: 0; }
    .card-md h3 { font-size: 0.85rem; font-weight: 700; color: #cccccc; margin: 0.9rem 0 0.3rem; }
    .card-md p  { font-size: 0.85rem; line-height: 1.6; color: #c0c0c0; margin-bottom: 0.6rem; }
    .card-md ul, .card-md ol { padding-left: 1.3rem; margin-bottom: 0.6rem; }
    .card-md li { font-size: 0.85rem; line-height: 1.6; color: #c0c0c0; margin-bottom: 0.2rem; }
    .card-md code { background: #3a3a3a; padding: 0.1em 0.3em; border-radius: 3px; font-size: 0.83em; font-family: 'Courier New', monospace; color: #9cdcfe; }
    .card-md pre  { background: #1e1e1e; border: 1px solid #3e3e3e; border-radius: 4px; padding: 0.6rem 0.75rem; overflow-x: auto; margin-bottom: 0.6rem; }
    .card-md pre code { background: none; padding: 0; color: #d4d4d4; font-size: 0.82rem; }
    .card-md strong { font-weight: 700; color: #d4d4d4; }
    .card-md blockquote { border-left: 3px solid #555; padding-left: 0.6rem; color: #9e9e9e; margin-bottom: 0.6rem; }
    .card-md hr { border: none; border-top: 1px solid #3e3e3e; margin: 0.75rem 0; }

    /* Try it button */
    .try-it-btn {
      display: block;
      margin-top: 1.25rem;
      width: 100%;
      padding: 0.55rem 1rem;
      background: #0e639c;
      color: #fff;
      border: none;
      border-radius: 4px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      text-align: center;
    }
    .try-it-btn:hover:not(:disabled) { background: #1177bb; }
    .try-it-btn:disabled { opacity: 0.6; cursor: default; }

    /* ── Editor pane ── */
    .editor-pane {
      flex: 1;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }
    #monaco-container {
      flex: 1;
      overflow: hidden;
    }

    /* ── Preview pane ── */
    .preview-pane {
      flex: 1;
      border-left: 1px solid #3e3e3e;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .preview-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0 0.75rem;
      height: 34px;
      background: #2d2d2d;
      border-bottom: 1px solid #3e3e3e;
      flex-shrink: 0;
      font-size: 0.75rem;
      color: #9e9e9e;
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }
    .preview-tabs { display: flex; gap: 0.3rem; }
    .view-tab {
      background: none;
      border: 1px solid transparent;
      border-radius: 3px;
      color: #9e9e9e;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.07em;
      padding: 0.2rem 0.5rem;
      cursor: pointer;
      white-space: nowrap;
    }
    .view-tab:hover { color: #d4d4d4; }
    .view-tab.active { color: #d4d4d4; background: #3e3e3e; }
    .preview-breadcrumb {
      display: none;
      align-items: center;
      gap: 0.5rem;
      padding: 0.35rem 0.75rem;
      background: #37373d;
      border-bottom: 1px solid #3e3e3e;
      font-size: 0.78rem;
      color: #cccccc;
      flex-shrink: 0;
    }
    .preview-breadcrumb.visible { display: flex; }
    .preview-breadcrumb a { color: #4fa3e0; text-decoration: none; cursor: pointer; }
    .preview-breadcrumb a:hover { text-decoration: underline; }
    .preview-note {
      display: none;
      padding: 0.5rem 0.75rem;
      background: #4a3b1f;
      color: #e8c07d;
      font-size: 0.78rem;
      border-bottom: 1px solid #3e3e3e;
      flex-shrink: 0;
    }
    .preview-note.visible { display: block; }
    #preview-frame {
      flex: 1;
      border: none;
      background: #fff;
      display: block;
    }

    /* ── Console (briefs/newborn-swing-console-brief.md) ──
       A read-only strip above the preview. Collapsed = just the strip;
       .open adds the fixed-height message panel. */
    .console { flex-shrink: 0; border-bottom: 1px solid #3e3e3e; background: #1e1e1e; }
    .console-strip {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      height: 26px;
      padding: 0 0.5rem 0 0.75rem;
      background: #252526;
      font-size: 0.72rem;
      color: #9e9e9e;
      text-transform: uppercase;
      letter-spacing: 0.07em;
    }
    .console-toggle {
      flex: 1;
      display: flex;
      align-items: center;
      gap: 0.4rem;
      height: 100%;
      padding: 0;
      background: none;
      border: none;
      color: inherit;
      font: inherit;
      letter-spacing: inherit;
      text-transform: inherit;
      text-align: left;
      cursor: pointer;
    }
    .console-toggle:hover { color: #d4d4d4; }
    .console-chevron { display: inline-block; transition: transform 0.15s; }
    .console.open .console-chevron { transform: rotate(90deg); }
    .console-dot { display: none; width: 7px; height: 7px; border-radius: 50%; background: #4fa3e0; }
    .console-dot.visible { display: inline-block; }
    .console-dot.error { background: #f44747; }
    .console-clear {
      display: none;
      background: none;
      border: 1px solid #3e3e3e;
      border-radius: 3px;
      color: #9e9e9e;
      font-size: 0.7rem;
      padding: 0.1rem 0.5rem;
      cursor: pointer;
    }
    .console.open .console-clear { display: inline-block; }
    .console-clear:hover { color: #d4d4d4; }
    .console-body {
      display: none;
      height: 150px;
      overflow-y: auto;
      font-family: Consolas, 'Droid Sans Mono', 'Courier New', monospace;
      font-size: 12px;
    }
    .console.open .console-body { display: block; }
    .console-empty { padding: 0.5rem 0.75rem; color: #6a6a6a; }
    .console-line {
      display: flex;
      gap: 0.5rem;
      padding: 0.15rem 0.75rem;
      border-bottom: 1px solid #2a2a2a;
      color: #d4d4d4;
      white-space: pre-wrap;
      word-break: break-word;
    }
    .console-mark { flex-shrink: 0; width: 1em; }
    .console-line.warn { color: #e8c07d; background: #332b00; }
    .console-line.error { color: #f48771; background: #3a1d1d; }
    .console-line.note { color: #9e9e9e; font-style: italic; }
    .tree-view { flex: 1; display: none; flex-direction: column; overflow: hidden; background: #1e1e1e; }
    #preview-pane.mode-tree #preview-frame { display: none; }
    #preview-pane.mode-tree .tree-view { display: flex; }
    .tree-summary {
      padding: 0.5rem 1rem 0;
      font-size: 0.75rem;
      color: #9e9e9e;
      flex-shrink: 0;
    }
    .tree-summary.bad { color: #f44747; font-weight: 600; }
    .tree-pane {
      flex: 1;
      overflow: auto;
      margin: 0;
      padding: 0.5rem 1rem 1rem;
      font-family: "Courier New", Courier, monospace;
      font-size: 0.82rem;
      line-height: 1.6;
      color: #d4d4d4;
      white-space: pre;
    }
    .tag-added { background: #3a1f1f; color: #f44747; font-weight: bold; }

    /* ── Menu data modal ── */
    .menu-modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.55);
      z-index: 50;
      align-items: center;
      justify-content: center;
    }
    .menu-modal-overlay.open { display: flex; }
    .menu-modal {
      background: #252526;
      border: 1px solid #3e3e3e;
      border-radius: 6px;
      width: min(960px, 94vw);
      max-height: 88vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    .menu-modal-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 1.25rem;
      border-bottom: 1px solid #3e3e3e;
      flex-shrink: 0;
    }
    .menu-modal-header h2 { font-size: 1rem; color: #d4d4d4; margin-bottom: 0.4rem; }
    .menu-address-row {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: #9e9e9e;
      flex-wrap: wrap;
    }
    .menu-address-row code {
      background: #1e1e1e;
      border: 1px solid #3e3e3e;
      border-radius: 3px;
      padding: 0.2rem 0.5rem;
      color: #9cdcfe;
      font-size: 0.78rem;
      word-break: break-all;
    }
    .menu-modal-body {
      flex: 1;
      overflow: auto;
      padding: 1rem 1.25rem;
    }
    .menu-grid-wrap { overflow-x: auto; }
    .menu-grid { border-collapse: collapse; width: 100%; min-width: 820px; }
    .menu-grid th {
      text-align: left;
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      color: #9e9e9e;
      padding: 0.4rem 0.5rem;
      border-bottom: 1px solid #3e3e3e;
    }
    .menu-grid td {
      padding: 0.3rem 0.5rem;
      border-bottom: 1px solid #333;
      vertical-align: top;
    }
    .menu-grid input, .menu-grid textarea {
      width: 100%;
      background: #1e1e1e;
      border: 1px solid #3e3e3e;
      border-radius: 3px;
      color: #d4d4d4;
      font-size: 0.82rem;
      padding: 0.3rem 0.4rem;
      font-family: inherit;
    }
    .menu-grid input:disabled, .menu-grid textarea:disabled { opacity: 0.75; }
    .menu-grid input.cell-error, .menu-grid textarea.cell-error { border-color: #f44747; }
    .menu-grid textarea { resize: vertical; min-height: 2rem; }
    .menu-row-num { color: #666; font-size: 0.78rem; white-space: nowrap; padding-top: 0.5rem !important; }
    .menu-row-actions { display: flex; gap: 0.2rem; white-space: nowrap; }
    .menu-row-actions button {
      background: none; border: 1px solid #3e3e3e; border-radius: 3px;
      color: #9e9e9e; cursor: pointer; font-size: 0.75rem; padding: 0.15rem 0.35rem;
    }
    .menu-row-actions button:hover:not(:disabled) { background: #3e3e3e; color: #d4d4d4; }
    .menu-row-actions button:disabled { opacity: 0.35; cursor: default; }
    .menu-row-actions .menu-del:hover:not(:disabled) { color: #f44747; background: rgba(244,71,71,0.15); }
    .menu-cell-error-msg { color: #f44747; font-size: 0.72rem; margin-top: 0.2rem; }
    .menu-modal-footer {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 0.75rem;
      padding: 0.75rem 1.25rem;
      border-top: 1px solid #3e3e3e;
      flex-shrink: 0;
    }
    #menu-save-status { font-size: 0.8rem; color: #6a9955; }
    #menu-save-status.error { color: #f44747; }
  </style>
</head>
<body>

  <!-- Header -->
  <header class="ide-header">
    <a href="javascript:history.back()" class="hdr-back">&#8592; Back</a>
    <span class="hdr-title"><%= project.title %><% if (readonly) { %> <span style="color:#f9a825;font-size:0.75rem;font-weight:600;margin-left:0.5rem">READ-ONLY</span><% } %></span>
    <% if (!readonly) { %>
    <span class="hdr-save" id="save-indicator"></span>
    <% if (cardCode) { %>
    <button class="hdr-btn" id="card-toggle-btn" onclick="toggleDrawer()">&#x1F4CB; Card</button>
    <% } %>
    <button class="hdr-btn" id="upload-btn" onclick="document.getElementById('img-file-input').click()" title="Upload an image and insert its URL">&#128444; Image</button>
    <input type="file" id="img-file-input" accept="image/*" style="display:none" onchange="uploadImage(this)">
    <% } %>
    <% if (menuPublicId) { %>
    <button class="hdr-btn" id="menu-data-btn" onclick="openMenuModal()">&#127869; Menu data</button>
    <% } %>
    <button class="hdr-btn hdr-btn-run" onclick="refreshPreview()">&#9654; Run</button>
  </header>

  <!-- Menu data modal (briefs/newborn-swing-menu-data-brief.md) -->
  <% if (menuPublicId) { %>
  <div class="menu-modal-overlay" id="menu-modal-overlay" aria-hidden="true">
    <div class="menu-modal" role="dialog" aria-label="Menu data">
      <div class="menu-modal-header">
        <div>
          <h2>Menu data<% if (readonly) { %> <span style="color:#f9a825;font-size:0.72rem;font-weight:600">READ-ONLY</span><% } %></h2>
          <div class="menu-address-row">
            <span>Data address:</span>
            <code id="menu-address-text"></code>
            <button type="button" class="hdr-btn" onclick="copyMenuAddress()">Copy</button>
          </div>
        </div>
        <button class="drawer-close" onclick="closeMenuModal()" aria-label="Close menu data">&#x2715;</button>
      </div>
      <div class="menu-modal-body">
        <div class="menu-grid-wrap">
          <table class="menu-grid" id="menu-grid">
            <thead>
              <tr>
                <th></th>
                <th>Name</th>
                <th>Price</th>
                <th>Category</th>
                <th>Description</th>
                <th>Dietary notes (comma-separated)</th>
                <% if (canEditMenu) { %><th></th><% } %>
              </tr>
            </thead>
            <tbody id="menu-grid-body"></tbody>
          </table>
        </div>
        <% if (canEditMenu) { %>
        <button type="button" class="add-btn" id="menu-add-row" onclick="addMenuRow()">+ Add row</button>
        <% } %>
      </div>
      <div class="menu-modal-footer">
        <span id="menu-save-status"></span>
        <% if (canEditMenu) { %>
        <button type="button" class="hdr-btn hdr-btn-run" id="menu-save-btn" onclick="saveMenuRows()">Save</button>
        <% } %>
      </div>
    </div>
  </div>
  <% } %>

  <!-- Tab bar -->
  <div class="ide-tabs" id="tab-bar"></div>

  <!-- IDE main area -->
  <div class="ide-main">

    <!-- Card drawer -->
    <aside class="card-drawer" id="card-drawer" aria-label="Checkpoint card" aria-hidden="true">
      <div class="drawer-inner">
        <div class="drawer-header">
          <div class="drawer-header-text">
            <div class="drawer-code" id="drawer-code"></div>
            <div class="drawer-title" id="drawer-title"></div>
          </div>
          <button class="drawer-close" onclick="closeDrawer()" aria-label="Close card">&#x2715;</button>
        </div>
        <div class="drawer-body" id="drawer-body">
          <p class="drawer-loading">Loading card…</p>
        </div>
      </div>
    </aside>

    <!-- Monaco editor -->
    <div class="editor-pane">
      <div id="monaco-container"></div>
    </div>

    <!-- Preview -->
    <div class="preview-pane" id="preview-pane">
      <div class="preview-header">
        <div class="preview-tabs" role="tablist">
          <button type="button" class="view-tab active" id="view-tab-preview" role="tab" aria-selected="true" onclick="setViewMode('preview')">Preview</button>
          <button type="button" class="view-tab" id="view-tab-tree" role="tab" aria-selected="false" onclick="setViewMode('tree')">What the browser built</button>
        </div>
        <span id="preview-title" style="text-transform:none;letter-spacing:normal;color:#d4d4d4;font-weight:600;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:40%;"></span>
      </div>
      <div class="preview-breadcrumb" id="preview-breadcrumb">
        <span id="preview-breadcrumb-file"></span>
        <a onclick="renderPreviewFile('index.html')">&#8592; Back to index.html</a>
      </div>
      <div class="preview-note" id="preview-note"></div>
      <div class="console" id="console">
        <div class="console-strip">
          <button type="button" class="console-toggle" id="console-toggle" aria-expanded="false" aria-controls="console-body" onclick="toggleConsole()">
            <span class="console-chevron" aria-hidden="true">&#9656;</span>
            Console
            <span class="console-dot" id="console-dot" role="img"></span>
          </button>
          <button type="button" class="console-clear" onclick="clearConsole()">Clear</button>
        </div>
        <div class="console-body" id="console-body" role="log">
          <div class="console-empty" id="console-empty">Nothing here yet. Messages from your JavaScript will appear here.</div>
        </div>
      </div>
      <iframe
        id="preview-frame"
        sandbox="allow-scripts allow-same-origin"
        title="Live preview of your web page"
      ></iframe>
      <div class="tree-view" id="tree-view">
        <p class="tree-summary" id="tree-summary"></p>
        <pre class="tree-pane" id="tree-pane"></pre>
      </div>
    </div>

  </div>

  <script src="https://cdn.jsdelivr.net/npm/marked@9/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs/loader.js"></script>
  <script>
    marked.use({ renderer: { html(t) { return (t.raw||'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); } } });

    // ── Data from server ──
    const projectId      = <%= project.id %>;
    const initialFiles   = <%- filesJson %>;
    const initialCardCode = <%- JSON.stringify(cardCode) %>;
    const READONLY       = <%= readonly %>;
    const menuPublicId   = <%- JSON.stringify(menuPublicId) %>;
    const initialMenuRows = <%- menuJson %>;
    const CAN_EDIT_MENU  = <%= canEditMenu %>;

    // ── Runtime state ──
    let files          = initialFiles.map(f => ({ ...f }));
    let editor         = null;
    let models         = {};   // fileId -> Monaco model
    let activeFileId   = null;
    let autosaveTimers = {};
    let previewTimer   = null;
    let watchdogTimer  = null;

    // ── Utilities ──
    function langFromPath(path) {
      if (/\.html?$/i.test(path)) return 'html';
      if (/\.css$/i.test(path))   return 'css';
      if (/\.js$/i.test(path))    return 'javascript';
      return 'plaintext';
    }

    function setSaveIndicator(state) {
      const el = document.getElementById('save-indicator');
      if (state === 'saving') { el.textContent = 'Saving…'; el.className = 'hdr-save saving'; }
      else if (state === 'saved') { el.textContent = 'Saved ✓'; el.className = 'hdr-save'; }
      else if (state === 'error') { el.textContent = 'Save failed'; el.className = 'hdr-save error'; }
      else { el.textContent = ''; el.className = 'hdr-save'; }
    }

    // ── What the browser built ──
    // Lifted from briefs/browser-tree-demo.html: uses the browser's own HTML
    // parser (via DOMParser) to show the tree it actually built, with any tag
    // it had to add to make the source well-formed marked in red. Read-only —
    // never edits the student's file. Deliberately does not "tidy" anything;
    // see BRIEF-browser-tree-panel.md for why.
    const VOID = new Set(['area','base','br','col','embed','hr','img','input','link','meta','param','source','track','wbr']);

    function escTree(s) {
      return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    // Which opening tags in the SOURCE never got an explicit closing tag.
    // Returns a Set of "tagname#n" keys, n counting that tag in source order.
    function unclosedInSource(src) {
      const stack = [];
      const counts = {};
      const explicitlyClosed = new Set();
      const re = /<\s*(\/?)\s*([a-zA-Z][a-zA-Z0-9]*)[^>]*?(\/?)\s*>/g;
      let m;
      while ((m = re.exec(src)) !== null) {
        const closing = m[1] === '/';
        const name = m[2].toLowerCase();
        const selfClosed = m[3] === '/';
        if (VOID.has(name) || selfClosed) continue;
        if (!closing) {
          counts[name] = (counts[name] || 0) + 1;
          stack.push({ name, key: name + '#' + counts[name] });
        } else {
          for (let i = stack.length - 1; i >= 0; i--) {
            if (stack[i].name === name) {
              explicitlyClosed.add(stack[i].key);
              stack.splice(i, 1);
              break;
            }
          }
        }
      }
      const missing = new Set();
      for (const name in counts) {
        for (let i = 1; i <= counts[name]; i++) {
          const key = name + '#' + i;
          if (!explicitlyClosed.has(key)) missing.add(key);
        }
      }
      return missing;
    }

    function countSourceTags(src) {
      const re = /<\s*(\/?)\s*[a-zA-Z][a-zA-Z0-9]*[^>]*?\/?\s*>/g;
      let count = 0, m;
      while ((m = re.exec(src)) !== null) {
        if (m[1] !== '/') count++;
      }
      return count;
    }

    function buildBrowserTree(src) {
      const missing = unclosedInSource(src);
      const doc = new DOMParser().parseFromString(src, 'text/html');

      const seen = {};
      const lines = [];
      let addedCount = 0;
      let totalTags = 0;

      function walk(node, depth) {
        const pad = '  '.repeat(depth);
        for (const child of node.childNodes) {
          if (child.nodeType === 3) {
            const text = child.textContent.replace(/\s+/g, ' ').trim();
            if (text) lines.push(escTree(pad + text));
            continue;
          }
          if (child.nodeType !== 1) continue;

          const name = child.tagName.toLowerCase();
          totalTags++;
          seen[name] = (seen[name] || 0) + 1;
          const key = name + '#' + seen[name];

          let attrs = '';
          for (const a of child.attributes) attrs += ' ' + a.name + '="' + a.value + '"';

          if (VOID.has(name)) {
            lines.push(escTree(pad + '<' + name + attrs + '>'));
            continue;
          }

          lines.push(escTree(pad + '<' + name + attrs + '>'));
          walk(child, depth + 1);

          const closeLine = escTree(pad + '</' + name + '>');
          const wasAdded = missing.has(key) || !new RegExp('<\\s*' + name + '[\\s>]', 'i').test(src);
          if (wasAdded) {
            addedCount++;
            lines.push('<span class="tag-added">' + closeLine + '   ← the browser added this</span>');
          } else {
            lines.push(closeLine);
          }
        }
      }

      walk(doc.documentElement.parentNode, 0);
      return { html: lines.join('\n'), addedCount, totalTags };
    }

    function updateTreePanel(fileMap) {
      const summaryEl = document.getElementById('tree-summary');
      const paneEl = document.getElementById('tree-pane');
      const src = fileMap['index.html'];

      if (!src) {
        summaryEl.className = 'tree-summary';
        summaryEl.textContent = '';
        paneEl.innerHTML = '<span style="color:#666">Add an index.html file to see this here.</span>';
        return;
      }

      const { html, addedCount, totalTags } = buildBrowserTree(src);
      const sourceTagCount = countSourceTags(src);
      paneEl.innerHTML = html;

      if (addedCount === 0) {
        summaryEl.className = 'tree-summary';
        summaryEl.textContent = `${sourceTagCount} tags in your file, ${totalTags} in the browser's version. The browser did not have to add anything.`;
      } else {
        summaryEl.className = 'tree-summary bad';
        summaryEl.textContent = `${sourceTagCount} tags in your file, ${totalTags} in the browser's version — it added ${addedCount} closing ${addedCount === 1 ? 'tag' : 'tags'} that you did not write.`;
      }
    }

    function setViewMode(mode) {
      document.getElementById('preview-pane').classList.toggle('mode-tree', mode === 'tree');
      const previewTab = document.getElementById('view-tab-preview');
      const treeTab = document.getElementById('view-tab-tree');
      previewTab.classList.toggle('active', mode === 'preview');
      previewTab.setAttribute('aria-selected', mode === 'preview');
      treeTab.classList.toggle('active', mode === 'tree');
      treeTab.setAttribute('aria-selected', mode === 'tree');
    }

    // ── Preview ──
    // Intercepts clicks inside the preview and posts the intent to the
    // parent instead of navigating. A srcdoc/document.write()'d iframe has
    // no real URL of its own for its project's relative links to resolve
    // against, so a plain <a href="farms.html"> would otherwise resolve
    // against THIS page's own address and 500. See briefs/FIX-preview-links.md.
    // NOTE: this text lives inside THIS page's own inline script tag. Any
    // closing script tag written into it must stay escaped with a
    // backslash (like the heartbeat script below does), or the HTML
    // parser ends this whole block early and breaks the page before any
    // of this code ever runs — the parser doesn't know JS comments or
    // strings exist, it just scans raw bytes (same class of bug already
    // hit once with the heartbeat script below).
    const NAV_INJECT = `
<script>
(function () {
  document.addEventListener('click', function (e) {
    var a = e.target.closest && e.target.closest('a');
    if (!a) return;
    var raw = a.getAttribute('href');
    if (raw === null) return;
    if (raw.charAt(0) === '#') return; // in-page anchor: let the browser handle it
    e.preventDefault();
    var scheme = /^([a-zA-Z][a-zA-Z0-9+.-]*):/.exec(raw);
    var kind;
    if (!scheme) kind = 'internal';
    else if (/^https?$/i.test(scheme[1])) kind = 'external';
    else kind = 'special'; // mailto:, tel:, etc.
    parent.postMessage({ __previewNav: true, kind: kind, href: raw }, '*');
  }, true);
})();
<\/script>`;

    // ── Console agent (briefs/newborn-swing-console-brief.md) ──
    // Runs INSIDE the preview frame, never here: CONSOLE_INJECT below
    // serializes it with toString(), so it must not touch anything from this
    // page's scope. Injected first in the preview's <head> so it is in place
    // before any of the student's scripts run. It wraps console.log/info/
    // warn/error, reports uncaught errors and unhandled promise rejections
    // (how an unhandled failed fetch() shows up), and formats every value to
    // plain text up front — functions and DOM nodes can't be posted as-is.
    // Same writing rule as NAV_INJECT: nothing in here may contain a
    // closing script tag.
    function previewConsoleAgent() {
      var MAX_DEPTH = 3, MAX_ITEMS = 100, MAX_KEYS = 50, MAX_TEXT = 2000, MAX_PER_SEC = 100;

      function send(msg) {
        msg.__nsConsole = true;
        try { parent.postMessage(msg, '*'); } catch (e) { /* parent gone */ }
      }

      // Rate limit, so a runaway loop doesn't flood the IDE with messages:
      // past MAX_PER_SEC in one second, count instead of send, and report
      // the count once ("N more messages hidden") when the second is up.
      var windowStart = 0, sentInWindow = 0, hidden = 0, flushTimer = null;
      function flushHidden() {
        if (flushTimer) { clearTimeout(flushTimer); flushTimer = null; }
        if (hidden) { send({ type: 'hidden', count: hidden }); hidden = 0; }
      }
      function allow() {
        var now = Date.now();
        if (now - windowStart >= 1000) { flushHidden(); windowStart = now; sentInWindow = 0; }
        if (sentInWindow < MAX_PER_SEC) { sentInWindow++; return true; }
        hidden++;
        if (!flushTimer) flushTimer = setTimeout(flushHidden, 1000 - (now - windowStart));
        return false;
      }

      function cap(s) { return s.length > MAX_TEXT ? s.slice(0, MAX_TEXT) + '…' : s; }
      function indent(s) { return '  ' + s.replace(/\n/g, '\n  '); }
      function keyText(k) { return /^[A-Za-z_$][\w$]*$/.test(k) ? k : JSON.stringify(k); }

      function fmtNode(n) {
        if (n.nodeType === 1) {
          var s = '<' + n.tagName.toLowerCase();
          if (n.id) s += ' id="' + n.id + '"';
          var cls = n.getAttribute('class');
          if (cls) s += ' class="' + cls + '"';
          return s + '>';
        }
        if (n.nodeType === 3) return '#text ' + JSON.stringify(n.textContent.length > 50 ? n.textContent.slice(0, 50) + '…' : n.textContent);
        return n.nodeName.toLowerCase();
      }

      // top: a string straight from console.log prints bare; strings inside
      // an array or object keep their quotes so "7" and 7 look different.
      function fmt(v, top, depth, seen) {
        var t = typeof v;
        if (t === 'string') return top ? v : JSON.stringify(v);
        if (v === null || t === 'number' || t === 'boolean' || t === 'undefined') return String(v);
        if (t === 'bigint') return String(v) + 'n';
        if (t === 'symbol') return v.toString();
        if (t === 'function') return '[function]';
        if (v instanceof Error) return v.name + ': ' + v.message;
        if (typeof Node === 'function' && v instanceof Node) return fmtNode(v);
        if (v instanceof Date) return isNaN(v) ? 'Invalid Date' : v.toString();
        if (depth >= MAX_DEPTH || seen.indexOf(v) !== -1) return '[...]';
        seen.push(v);
        try {
          var parts = [], i;
          if (Array.isArray(v)) {
            if (!v.length) return '[]';
            var n = Math.min(v.length, MAX_ITEMS), allObjects = true;
            for (i = 0; i < n; i++) {
              parts.push(fmt(v[i], false, depth + 1, seen));
              if (!v[i] || typeof v[i] !== 'object') allObjects = false;
            }
            if (v.length > n) parts.push('… ' + (v.length - n) + ' more');
            // An array of objects (D1's list of dishes) gets one object per line.
            if (allObjects) return '[\n' + parts.map(indent).join(',\n') + '\n]';
            return '[ ' + parts.join(', ') + ' ]';
          }
          var ctor = v.constructor && v.constructor.name;
          var prefix = ctor && ctor !== 'Object' ? ctor + ' ' : '';
          if (v instanceof Map) {
            v.forEach(function (val, key) {
              if (parts.length < MAX_KEYS) parts.push(fmt(key, false, depth + 1, seen) + ' => ' + fmt(val, false, depth + 1, seen));
            });
          } else if (v instanceof Set) {
            v.forEach(function (val) {
              if (parts.length < MAX_KEYS) parts.push(fmt(val, false, depth + 1, seen));
            });
          } else {
            var keys = Object.keys(v);
            for (i = 0; i < keys.length && i < MAX_KEYS; i++) {
              var shown;
              try { shown = fmt(v[keys[i]], false, depth + 1, seen); } catch (e) { shown = '[error reading value]'; }
              parts.push(keyText(keys[i]) + ': ' + shown);
            }
            if (keys.length > MAX_KEYS) parts.push('… ' + (keys.length - MAX_KEYS) + ' more');
          }
          return prefix + (parts.length ? '{ ' + parts.join(', ') + ' }' : '{}');
        } finally {
          seen.pop();
        }
      }

      function safeFmt(v) {
        try { return cap(fmt(v, true, 0, [])); } catch (e) { return '[value that could not be shown]'; }
      }

      ['log', 'info', 'warn', 'error'].forEach(function (method) {
        var original = console[method];
        console[method] = function () {
          if (allow()) {
            var values = [];
            for (var i = 0; i < arguments.length; i++) values.push(safeFmt(arguments[i]));
            send({ type: method, values: values });
          }
          // The browser's own console still gets the original call.
          if (original) return original.apply(console, arguments);
        };
      });

      window.addEventListener('error', function (e) {
        if (!allow()) return;
        send({
          type: 'uncaught',
          values: [cap(String(e.message || 'Script error.'))],
          file: String(e.filename || ''),
          line: e.lineno || 0,
          samePage: e.filename === location.href,
        });
      });

      window.addEventListener('unhandledrejection', function (e) {
        if (!allow()) return;
        send({ type: 'uncaught', values: ['(in promise) ' + safeFmt(e.reason)] });
      });

      send({ type: 'page-loaded' });
    }
    const CONSOLE_INJECT = '<script>(' + previewConsoleAgent.toString() + ')();<\/script>';

    // Where each script block in the preview came from, keyed by the
    // `//# sourceURL=` name buildPreviewDoc() tags it with. The browser
    // reports an error's file as that name and its line counted from the top
    // of that block, so this turns it back into the student's own file and
    // line. Rebuilt on every preview render.
    let previewScriptBlocks = new Map();
    // <script src> paths that named no file in the project, reported in the
    // console once the render's page-loaded message arrives.
    let previewMissingScripts = [];
    // Whether any script survived into the built page. The loop watchdog
    // keys off this, not the raw files: a <script src> naming a missing file
    // is dropped, so the heartbeat never comes and the watchdog would
    // wrongly report an infinite loop.
    let previewHasScripts = false;

    let currentPreviewPath = 'index.html';

    function gatherFileMap() {
      const fileMap = {};
      for (const f of files) {
        fileMap[f.path] = models[f.id] ? models[f.id].getValue() : f.content;
      }
      return fileMap;
    }

    function updateBreadcrumb(path) {
      const bar = document.getElementById('preview-breadcrumb');
      if (path === 'index.html') {
        bar.classList.remove('visible');
      } else {
        document.getElementById('preview-breadcrumb-file').textContent = path;
        bar.classList.add('visible');
      }
    }

    function showPreviewNote(msg) {
      const note = document.getElementById('preview-note');
      note.textContent = msg;
      note.classList.add('visible');
      clearTimeout(showPreviewNote._t);
      showPreviewNote._t = setTimeout(() => note.classList.remove('visible'), 5000);
    }

    function buildPreviewDoc(fileMap, path) {
      path = path || 'index.html';
      previewScriptBlocks = new Map();
      previewMissingScripts = [];
      previewHasScripts = false;
      let html = fileMap[path];
      if (!html) {
        return path === 'index.html'
          ? `<html><body style="font-family:sans-serif;padding:2rem;color:#666">
              <p>Add an <code>index.html</code> file to see a preview here.</p>
            </body></html>`
          : `<html><body style="font-family:sans-serif;padding:2rem;color:#666">
              <p>There is no file called ${path}.</p>
            </body></html>`;
      }


      // Tag the page's own inline <script> blocks with a sourceURL so the
      // console can name the file and line of an error inside one. Must run
      // first, while offsets still match the student's file. Blocks that
      // aren't JavaScript (e.g. type="application/json") are left alone —
      // a trailing comment would break them.
      let inlineCount = 0;
      html = html.replace(/(<script\b([^>]*)>)([\s\S]*?)(<\/script>)/gi, (whole, open, attrs, body, close, offset, src) => {
        if (!body.trim() || /\bsrc\s*=/i.test(attrs)) return whole;
        const type = /\btype\s*=\s*["']?([^"'\s>]+)/i.exec(attrs);
        if (type && !/^(text\/javascript|application\/javascript|module)$/i.test(type[1])) return whole;
        const name = `ns-inline-${++inlineCount}`;
        // Line 1 of the block is the line its <script> tag ends on.
        previewScriptBlocks.set(name, { file: path, firstLine: src.slice(0, offset + open.length).split('\n').length });
        return `${open}${body}\n//# sourceURL=${name}\n${close}`;
      });

      // Inline <link rel="stylesheet" href="..."> → <style>
      html = html.replace(/<link\b([^>]*)>/gi, (tag, attrs) => {
        if (!/rel=["']stylesheet["']/i.test(attrs)) return tag;
        const m = attrs.match(/href=["']([^"']+)["']/i);
        if (!m) return '';
        return (m[1] in fileMap)
          ? `<style>\n${fileMap[m[1]]}\n</style>`
          : '';
      });

      // Inline <script src="..."><\/script> → <script>
      html = html.replace(/<script\b([^>]*?)><\/script>/gi, (tag, attrs) => {
        const m = attrs.match(/src=["']([^"']+)["']/i);
        if (!m) return tag;
        if (!(m[1] in fileMap)) {
          // A real browser would log a 404 in developer tools, which
          // students can't open — say so in the console instead. Web
          // addresses (a library from a CDN) aren't project files.
          if (!/^([a-z][a-z0-9+.-]*:)?\/\//i.test(m[1])) previewMissingScripts.push(m[1]);
          return '';
        }
        // The file's line 1 is the block's line 2 (after the leading \n).
        const name = m[1].replace(/\s/g, '%20');
        previewScriptBlocks.set(name, { file: m[1], firstLine: 0 });
        return `<script>\n${fileMap[m[1]]}\n//# sourceURL=${name}\n<\/script>`;
      });

      // Only inject heartbeat when the page has scripts; otherwise a malformed
      // tag like <p (no >) causes the parser to treat <script> as an attribute
      // name, leaving the heartbeat text visible on the page.
      previewHasScripts = /<script\b/i.test(html);
      if (previewHasScripts) {
        const heartbeat = `<script>window.parent.postMessage({type:"preview-ready"},"*")<\/script>`;
        html = /(<\/body>)/i.test(html)
          ? html.replace(/<\/body>/i, heartbeat + '\n</body>')
          : html + '\n' + heartbeat;
      }

      // Injected last (unconditionally — unlike the heartbeat above, plain
      // pages with no <script> of their own still need working links), so
      // it wins if anything else also listens for clicks.
      html = /(<\/body>)/i.test(html)
        ? html.replace(/<\/body>/i, NAV_INJECT + '\n</body>')
        : html + '\n' + NAV_INJECT;

      // The console agent goes in FIRST — before any student script — so
      // nothing they write can run before console.log is wrapped. Right after
      // <head> (or <html>, or the doctype, so a doctype stays first and the
      // page stays in standards mode). [^<>] keeps a malformed `<head` with
      // no `>` from matching across into the next tag.
      const start = /<head\b[^<>]*>/i.exec(html) || /<html\b[^<>]*>/i.exec(html) || /^\s*<!doctype\b[^<>]*>/i.exec(html);
      const at = start ? start.index + start[0].length : 0;
      html = html.slice(0, at) + CONSOLE_INJECT + html.slice(at);

      return html;
    }

    async function uploadImage(input) {
      const file = input.files[0];
      if (!file) return;
      input.value = '';
      const btn = document.getElementById('upload-btn');
      btn.textContent = 'Uploading…';
      btn.disabled = true;
      try {
        const fd = new FormData();
        fd.append('image', file);
        const res = await fetch('/api/upload', { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Upload failed');
        const tag = `<img src="${data.url}" alt="">`;
        const editor = monaco.editor.getEditors()[0];
        if (editor) {
          editor.trigger('upload', 'type', { text: tag });
        } else {
          navigator.clipboard.writeText(data.url);
          alert('Uploaded! URL copied to clipboard:\n' + data.url);
        }
      } catch (err) {
        alert('Upload failed: ' + err.message);
      } finally {
        btn.textContent = '🖼 Image';
        btn.disabled = false;
      }
    }

    function renderPreviewFile(path, fileMapArg) {
      currentPreviewPath = path;
      const fileMap = fileMapArg || gatherFileMap();

      const html = buildPreviewDoc(fileMap, path);
      // Only watch for infinite loops when a script actually made it into
      // the page (see previewHasScripts).
      const hasUserScripts = previewHasScripts;
      updateTreePanel(fileMap); // always index.html's tree — a separate, unrelated feature
      updateBreadcrumb(path);

      // Show <title> content in the preview header
      const titleMatch = html.match(/<title[^>]*>([^<]*)<\/title>/i);
      const titleEl = document.getElementById('preview-title');
      if (titleEl) titleEl.textContent = (titleMatch && titleMatch[1].trim()) || '';

      // A brand-new frame for every render. document.open() below would
      // otherwise reuse the previous run's window: its globals, listeners
      // and timers carry over, so a student's top-level `let`/`const` fails
      // with "has already been declared" on every refresh after the first,
      // and the console agent would wrap console.log a second time.
      const oldFrame = document.getElementById('preview-frame');
      const iframe = oldFrame.cloneNode(false);
      oldFrame.replaceWith(iframe);

      if (watchdogTimer) clearTimeout(watchdogTimer);

      // Use document.open/write/close instead of srcdoc so the browser does not
      // record a navigation history entry for each preview refresh.
      const doc = iframe.contentWindow.document;
      doc.open();
      doc.write(html);
      doc.close();

      // Watchdog: only active when user scripts are present (infinite loop risk)
      if (hasUserScripts) {
        watchdogTimer = setTimeout(() => {
          watchdogTimer = null;
          const d = iframe.contentWindow.document;
          d.open();
          d.write(`<html><body style="font-family:sans-serif;padding:2rem;color:#c0392b">
            <h2 style="margin-bottom:0.5rem">Preview stopped</h2>
            <p>A script might have an infinite loop. Fix your code and click <strong>Run</strong> to try again.</p>
          </body></html>`);
          d.close();
        }, 5000);
      }
    }

    function refreshPreview() {
      if (previewTimer) { clearTimeout(previewTimer); previewTimer = null; }
      // Editing a file or pressing Run always goes back to the start page —
      // otherwise a student mid-edit on index.html would see a stale
      // farms.html they navigated to two clicks ago.
      renderPreviewFile('index.html');
    }

    // Messages from the sandboxed preview iframe: the loop-watchdog
    // heartbeat, console output from CONSOLE_INJECT, and link clicks
    // intercepted by NAV_INJECT (see briefs/FIX-preview-links.md). The frame can end up same-origin
    // (sandbox allows it), so check e.source rather than trusting e.origin.
    window.addEventListener('message', (e) => {
      const iframe = document.getElementById('preview-frame');
      if (!iframe || e.source !== iframe.contentWindow) return;
      const d = e.data;
      if (!d || typeof d !== 'object') return;

      if (d.__nsConsole === true) { handleConsoleMessage(d); return; }

      if (d.type === 'preview-ready') {
        if (watchdogTimer) { clearTimeout(watchdogTimer); watchdogTimer = null; }
        return;
      }

      if (d.__previewNav !== true) return;

      if (d.kind === 'internal') {
        const target = d.href.split('#')[0].split('?')[0].replace(/^\.\//, '');
        const fileMap = gatherFileMap();
        if (fileMap[target] === undefined) {
          showPreviewNote('Broken link: there is no file called ' + target);
        } else {
          renderPreviewFile(target, fileMap);
        }
      } else if (d.kind === 'external') {
        window.open(d.href, '_blank', 'noopener');
      } else {
        showPreviewNote('This link opens ' + d.href + ' outside the browser.');
      }
    });

    function schedulePreviewRefresh() {
      if (previewTimer) clearTimeout(previewTimer);
      previewTimer = setTimeout(refreshPreview, 300);
    }

    // ── Console panel (briefs/newborn-swing-console-brief.md) ──
    // Everything in a message came from student code: validated here,
    // shown only with textContent, never as HTML.
    const CONSOLE_TYPES = new Set(['log', 'info', 'warn', 'error', 'uncaught', 'hidden', 'page-loaded']);
    const CONSOLE_MAX_LINES = 500;
    const CONSOLE_MAX_CHARS = 2000;
    const CONSOLE_MAX_PER_SEC = 100;

    // Open/closed: an explicit click wins (consoleManual), otherwise the
    // console opens once the project has a .js file or anything has been
    // logged. A new error clears a manual "closed" so the console reopens;
    // a plain log does not. Nothing is saved — reloading the IDE resets it.
    let consoleManual = null;        // null | 'open' | 'closed'
    let consoleHadMessage = false;
    let consoleUnread = null;        // null | 'normal' | 'error'
    let consoleLineCount = 0;
    let consoleRateStart = 0, consoleRateCount = 0, consoleRateHidden = 0, consoleRateTimer = null;

    function consoleShouldOpen() {
      if (consoleManual) return consoleManual === 'open';
      return consoleHadMessage || files.some(f => /\.js$/i.test(f.path));
    }

    function applyConsoleState() {
      const el = document.getElementById('console');
      const body = document.getElementById('console-body');
      const dot = document.getElementById('console-dot');
      const wasOpen = el.classList.contains('open');
      const open = consoleShouldOpen();
      el.classList.toggle('open', open);
      document.getElementById('console-toggle').setAttribute('aria-expanded', String(open));
      if (open) consoleUnread = null;
      dot.classList.toggle('visible', !!consoleUnread);
      dot.classList.toggle('error', consoleUnread === 'error');
      if (consoleUnread) dot.setAttribute('aria-label', consoleUnread === 'error' ? 'New errors' : 'New messages');
      else dot.removeAttribute('aria-label');
      if (open && !wasOpen) body.scrollTop = body.scrollHeight;
    }

    function toggleConsole() {
      consoleManual = consoleShouldOpen() ? 'closed' : 'open';
      applyConsoleState();
    }

    function clearConsole() {
      document.querySelectorAll('#console-body .console-line').forEach(l => l.remove());
      consoleLineCount = 0;
      document.getElementById('console-empty').hidden = false;
      consoleUnread = null;
      applyConsoleState();
    }

    function addConsoleLine(kind, text) {
      const body = document.getElementById('console-body');
      // Follow new lines only if the student hasn't scrolled up to read.
      const atBottom = body.scrollTop + body.clientHeight >= body.scrollHeight - 4;

      const line = document.createElement('div');
      line.className = 'console-line ' + kind;
      const mark = document.createElement('span');
      mark.className = 'console-mark';
      if (kind === 'warn' || kind === 'error') {
        mark.textContent = kind === 'warn' ? '⚠' : '✖';
        mark.setAttribute('role', 'img');
        mark.setAttribute('aria-label', kind === 'warn' ? 'Warning' : 'Error');
      }
      const msg = document.createElement('span');
      msg.textContent = text.length > CONSOLE_MAX_CHARS ? text.slice(0, CONSOLE_MAX_CHARS) + '…' : text;
      line.append(mark, msg);
      body.appendChild(line);

      consoleLineCount++;
      while (consoleLineCount > CONSOLE_MAX_LINES) {
        body.querySelector('.console-line').remove();
        consoleLineCount--;
      }
      document.getElementById('console-empty').hidden = true;
      if (atBottom) body.scrollTop = body.scrollHeight;
    }

    function flushConsoleHidden() {
      if (consoleRateTimer) { clearTimeout(consoleRateTimer); consoleRateTimer = null; }
      if (consoleRateHidden) {
        addConsoleLine('note', `${consoleRateHidden} more messages hidden`);
        consoleRateHidden = 0;
      }
    }

    // Turns the frame's file name + block-relative line into the student's
    // own file and line (see previewScriptBlocks). '' when unknown.
    function consoleErrorPlace(d) {
      const file = typeof d.file === 'string' ? d.file : '';
      const line = Number.isInteger(d.line) && d.line > 0 ? d.line : 0;
      const block = previewScriptBlocks.get(file);
      if (block) {
        const fileLine = block.firstLine + line - 1;
        return fileLine > 0 ? `${block.file}, line ${fileLine}` : block.file;
      }
      // Reported against the page itself but not inside a tagged block —
      // e.g. an onclick="..." attribute. The line number there is
      // meaningless, so name the page only.
      if (d.samePage === true || file === location.href) return currentPreviewPath;
      // A script loaded from the web (e.g. a library from a CDN).
      if (/^https?:/i.test(file)) {
        const name = file.split(/[?#]/)[0].split('/').pop() || file;
        return line ? `${name}, line ${line}` : name;
      }
      return '';
    }

    function handleConsoleMessage(d) {
      if (!CONSOLE_TYPES.has(d.type)) return;

      if (d.type === 'page-loaded') {
        // A fresh run of the preview: start the console over too.
        consoleRateHidden = 0;
        if (consoleRateTimer) { clearTimeout(consoleRateTimer); consoleRateTimer = null; }
        clearConsole();
        for (const src of previewMissingScripts) {
          showConsoleLine('error', `${currentPreviewPath}: <script src="${src}"> did not load — there is no file called ${src} in this project.`);
        }
        return;
      }

      // The frame limits itself, but student code can post here directly,
      // so enforce the same limit on this side.
      const now = Date.now();
      if (now - consoleRateStart >= 1000) { flushConsoleHidden(); consoleRateStart = now; consoleRateCount = 0; }
      if (consoleRateCount >= CONSOLE_MAX_PER_SEC) {
        consoleRateHidden++;
        if (!consoleRateTimer) consoleRateTimer = setTimeout(flushConsoleHidden, 1000 - (now - consoleRateStart));
        return;
      }
      consoleRateCount++;

      let kind, text;
      if (d.type === 'hidden') {
        const n = Number.isInteger(d.count) && d.count > 0 ? d.count : 0;
        if (!n) return;
        kind = 'note';
        text = `${n} more messages hidden`;
      } else {
        const values = Array.isArray(d.values) ? d.values.slice(0, 100).map(v => String(v)) : [];
        text = values.join(' ');
        if (d.type === 'uncaught') {
          // Chrome prefixes "Uncaught " itself and Firefox doesn't, and a
          // syntax error in a document.write()'d page comes wrapped in the
          // write call's own message — normalize both away.
          text = 'Uncaught ' + text.replace(/^Uncaught /, '').replace("Failed to execute 'write' on 'Document': ", '');
          const place = consoleErrorPlace(d);
          if (place) text = `${place}: ${text}`;
        }
        kind = d.type === 'warn' ? 'warn' : (d.type === 'error' || d.type === 'uncaught') ? 'error' : 'log';
      }
      showConsoleLine(kind, text);
    }

    // Adds a line and applies the open/dot rules for it.
    function showConsoleLine(kind, text) {
      consoleHadMessage = true;
      if (kind === 'error' && consoleManual === 'closed') consoleManual = null;
      addConsoleLine(kind, text);
      if (!consoleShouldOpen()) consoleUnread = (kind === 'error' || consoleUnread === 'error') ? 'error' : 'normal';
      applyConsoleState();
    }

    // ── Autosave ──
    async function saveFile(fileId) {
      const content = models[fileId].getValue();
      try {
        const res = await fetch(`/projects/${projectId}/files/${fileId}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ content }),
        });
        if (!res.ok) throw new Error('Save failed');
        setSaveIndicator('saved');
        setTimeout(() => setSaveIndicator(''), 2000);
      } catch {
        setSaveIndicator('error');
      }
    }

    function scheduleAutosave(fileId) {
      if (autosaveTimers[fileId]) clearTimeout(autosaveTimers[fileId]);
      setSaveIndicator('saving');
      autosaveTimers[fileId] = setTimeout(() => saveFile(fileId), 2000);
    }

    // ── Tab management ──
    function switchToFile(fileId) {
      activeFileId = fileId;
      editor.setModel(models[fileId]);
      editor.focus();
      document.querySelectorAll('.file-tab').forEach(t => {
        t.classList.toggle('active', Number(t.dataset.fileId) === fileId);
      });
    }

    function renderTabs() {
      const bar = document.getElementById('tab-bar');
      bar.innerHTML = '';

      for (const f of files) {
        const tab = document.createElement('button');
        tab.className = 'file-tab' + (f.id === activeFileId ? ' active' : '');
        tab.dataset.fileId = f.id;
        tab.addEventListener('click', () => switchToFile(f.id));

        const label = document.createTextNode(f.path);
        tab.appendChild(label);

        const del = document.createElement('span');
        del.className = 'tab-del';
        del.title = `Delete ${f.path}`;
        del.setAttribute('role', 'button');
        del.setAttribute('aria-label', `Delete ${f.path}`);
        del.textContent = '×';
        del.addEventListener('click', (e) => {
          e.stopPropagation();
          deleteFile(f.id, f.path);
        });
        tab.appendChild(del);

        bar.appendChild(tab);
      }

      const newBtn = document.createElement('button');
      newBtn.className = 'tab-new';
      newBtn.textContent = '+ New file';
      newBtn.addEventListener('click', newFile);
      bar.appendChild(newBtn);

      // The file list just changed: adding the first .js file opens the console.
      applyConsoleState();
    }

    async function newFile() {
      const path = prompt('File name (e.g. about.html):');
      if (!path || !path.trim()) return;
      const trimmed = path.trim();

      const res = await fetch(`/projects/${projectId}/files`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ path: trimmed }),
      });
      if (!res.ok) {
        const err = await res.json().catch(() => ({}));
        alert(err.error || 'Could not create file');
        return;
      }
      const newFileData = await res.json();
      files.push(newFileData);

      const model = monaco.editor.createModel('', langFromPath(newFileData.path));
      models[newFileData.id] = model;
      model.onDidChangeContent(() => {
        scheduleAutosave(newFileData.id);
        schedulePreviewRefresh();
      });

      renderTabs();
      switchToFile(newFileData.id);
    }

    async function deleteFile(fileId, filePath) {
      if (!confirm(`Delete ${filePath}? This cannot be undone.`)) return;

      const res = await fetch(`/projects/${projectId}/files/${fileId}`, { method: 'DELETE' });
      if (!res.ok) { alert('Could not delete file'); return; }

      models[fileId].dispose();
      delete models[fileId];
      files = files.filter(f => f.id !== fileId);

      if (activeFileId === fileId) {
        const next = files[0];
        activeFileId = next ? next.id : null;
        if (next) switchToFile(next.id);
        else editor.setModel(null);
      }

      renderTabs();
      refreshPreview();
    }

    // ── Menu data (briefs/newborn-swing-menu-data-brief.md) ──
    // dietary is kept as a single comma-separated string while a row is being
    // edited (that's what one grid cell holds) and only split into an array
    // right before Save.
    const MENU_LIMITS = { maxRows: 100, nameMax: 100, descMax: 500, dietaryMax: 10, dietaryWordMax: 30 };

    function menuRowToEditable(row) {
      return {
        name: row.name || '',
        price: (row.price === null || row.price === undefined) ? '' : String(row.price),
        category: row.category || '',
        description: row.description || '',
        dietary: Array.isArray(row.dietary) ? row.dietary.join(', ') : (row.dietary || ''),
      };
    }

    let menuRows = initialMenuRows.map(menuRowToEditable);
    let menuDirty = false;
    let menuRowErrors = {}; // rowIndex -> { field: message }

    function parseMenuPriceClient(raw) {
      const trimmed = String(raw || '').trim();
      if (trimmed === '') return { ok: true, value: null };
      const cleaned = trimmed.replace(/^\$/, '');
      if (!/^\d+(\.\d+)?$/.test(cleaned)) return { ok: false };
      return { ok: true, value: Number(cleaned) };
    }

    function splitDietary(raw) {
      return String(raw || '').split(',').map(d => d.trim()).filter(Boolean);
    }

    function menuAddressUrl() {
      return window.location.origin + '/api/menu/' + menuPublicId;
    }

    function renderMenuGrid() {
      const body = document.getElementById('menu-grid-body');
      body.innerHTML = '';

      menuRows.forEach((row, i) => {
        const tr = document.createElement('tr');
        const errs = menuRowErrors[i] || {};

        function cell(field, value, tag, extraAttrs) {
          const td = document.createElement('td');
          const el = document.createElement(tag);
          el.value = value;
          if (errs[field]) el.classList.add('cell-error');
          if (!CAN_EDIT_MENU) el.disabled = true;
          if (extraAttrs) Object.assign(el, extraAttrs);
          el.addEventListener('input', () => {
            menuRows[i][field] = el.value;
            menuDirty = true;
            if (menuRowErrors[i]) { delete menuRowErrors[i][field]; el.classList.remove('cell-error'); }
          });
          td.appendChild(el);
          if (errs[field]) {
            const msg = document.createElement('div');
            msg.className = 'menu-cell-error-msg';
            msg.textContent = errs[field];
            td.appendChild(msg);
          }
          return td;
        }

        const numTd = document.createElement('td');
        numTd.className = 'menu-row-num';
        numTd.textContent = String(i + 1);
        tr.appendChild(numTd);

        tr.appendChild(cell('name', row.name, 'input', { type: 'text', maxLength: MENU_LIMITS.nameMax }));
        tr.appendChild(cell('price', row.price, 'input', { type: 'text', placeholder: 'e.g. 9.00' }));
        tr.appendChild(cell('category', row.category, 'input', { type: 'text' }));
        tr.appendChild(cell('description', row.description, 'textarea', { maxLength: MENU_LIMITS.descMax, rows: 2 }));
        tr.appendChild(cell('dietary', row.dietary, 'input', { type: 'text', placeholder: 'vegetarian, gluten-free' }));

        if (CAN_EDIT_MENU) {
          const actionsTd = document.createElement('td');
          actionsTd.className = 'menu-row-actions';

          const upBtn = document.createElement('button');
          upBtn.type = 'button'; upBtn.textContent = '↑'; upBtn.title = 'Move up';
          upBtn.disabled = i === 0;
          upBtn.addEventListener('click', () => moveMenuRow(i, -1));

          const downBtn = document.createElement('button');
          downBtn.type = 'button'; downBtn.textContent = '↓'; downBtn.title = 'Move down';
          downBtn.disabled = i === menuRows.length - 1;
          downBtn.addEventListener('click', () => moveMenuRow(i, 1));

          const delBtn = document.createElement('button');
          delBtn.type = 'button'; delBtn.textContent = '×'; delBtn.title = 'Delete row';
          delBtn.className = 'menu-del';
          delBtn.addEventListener('click', () => deleteMenuRow(i));

          actionsTd.append(upBtn, downBtn, delBtn);
          tr.appendChild(actionsTd);
        }

        body.appendChild(tr);
      });

      const addBtn = document.getElementById('menu-add-row');
      if (addBtn) addBtn.disabled = menuRows.length >= MENU_LIMITS.maxRows;
    }

    function addMenuRow() {
      if (menuRows.length >= MENU_LIMITS.maxRows) return;
      menuRows.push({ name: '', price: '', category: '', description: '', dietary: '' });
      menuDirty = true;
      renderMenuGrid();
    }

    function deleteMenuRow(i) {
      if (!confirm('Delete this row? This cannot be undone.')) return;
      menuRows.splice(i, 1);
      delete menuRowErrors[i];
      menuDirty = true;
      renderMenuGrid();
    }

    function moveMenuRow(i, dir) {
      const j = i + dir;
      if (j < 0 || j >= menuRows.length) return;
      [menuRows[i], menuRows[j]] = [menuRows[j], menuRows[i]];
      menuDirty = true;
      renderMenuGrid();
    }

    function setMenuSaveStatus(text, isError) {
      const el = document.getElementById('menu-save-status');
      el.textContent = text;
      el.className = isError ? 'error' : '';
    }

    function validateMenuRowsClient() {
      menuRowErrors = {};
      let hasErrors = false;
      menuRows.forEach((row, i) => {
        const errs = {};
        const name = (row.name || '').trim();
        if (!name) errs.name = 'Name is required.';
        else if (name.length > MENU_LIMITS.nameMax) errs.name = `Keep it to ${MENU_LIMITS.nameMax} characters.`;

        if (!parseMenuPriceClient(row.price).ok) errs.price = 'Must be a number (e.g. 9 or 9.00), or blank.';

        const description = (row.description || '').trim();
        if (description.length > MENU_LIMITS.descMax) errs.description = `Keep it to ${MENU_LIMITS.descMax} characters.`;

        const dietary = splitDietary(row.dietary);
        if (dietary.length > MENU_LIMITS.dietaryMax) errs.dietary = `No more than ${MENU_LIMITS.dietaryMax} notes.`;
        else if (dietary.some(d => d.length > MENU_LIMITS.dietaryWordMax)) errs.dietary = `Each note must be ${MENU_LIMITS.dietaryWordMax} characters or fewer.`;

        if (Object.keys(errs).length) { menuRowErrors[i] = errs; hasErrors = true; }
      });
      return !hasErrors;
    }

    async function saveMenuRows() {
      if (!validateMenuRowsClient()) {
        renderMenuGrid();
        setMenuSaveStatus('Fix the highlighted cells before saving.', true);
        return;
      }

      const payload = menuRows.map(row => ({
        name: row.name.trim(),
        price: row.price,
        category: row.category.trim(),
        description: row.description.trim(),
        dietary: splitDietary(row.dietary),
      }));

      setMenuSaveStatus('Saving…', false);
      try {
        const res = await fetch(`/projects/${projectId}/menu`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ rows: payload }),
        });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) {
          if (Array.isArray(data.rowErrors)) {
            menuRowErrors = {};
            for (const { row, errors } of data.rowErrors) menuRowErrors[row] = errors;
            renderMenuGrid();
          }
          setMenuSaveStatus(data.error || 'Save failed.', true);
          return;
        }
        menuDirty = false;
        setMenuSaveStatus('Saved ✓', false);
        setTimeout(() => setMenuSaveStatus('', false), 2000);
      } catch {
        setMenuSaveStatus('Save failed.', true);
      }
    }

    function copyMenuAddress() {
      const url = menuAddressUrl();
      navigator.clipboard.writeText(url).then(() => {
        setMenuSaveStatus('Address copied.', false);
        setTimeout(() => setMenuSaveStatus('', false), 2000);
      }).catch(() => {
        alert('Data address:\n' + url);
      });
    }

    function openMenuModal() {
      document.getElementById('menu-address-text').textContent = menuAddressUrl();
      renderMenuGrid();
      document.getElementById('menu-modal-overlay').classList.add('open');
      document.getElementById('menu-modal-overlay').setAttribute('aria-hidden', 'false');
    }

    function closeMenuModal() {
      if (CAN_EDIT_MENU && menuDirty) {
        if (!confirm('You have unsaved changes to the menu data. Leave anyway?')) return;
        menuDirty = false;
      }
      document.getElementById('menu-modal-overlay').classList.remove('open');
      document.getElementById('menu-modal-overlay').setAttribute('aria-hidden', 'true');
    }

    // ── Card drawer ──
    let activeCardCode = null;

    async function openCard(code) {
      activeCardCode = code;
      const drawer = document.getElementById('card-drawer');
      document.getElementById('drawer-code').textContent = code;
      document.getElementById('drawer-title').textContent = '';
      document.getElementById('drawer-body').innerHTML = '<p class="drawer-loading">Loading…</p>';
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');

      try {
        const res = await fetch(`/cards/data/${code}`);
        if (!res.ok) throw new Error('Not found');
        const card = await res.json();

        document.getElementById('drawer-code').textContent = card.code;
        document.getElementById('drawer-title').textContent = card.title;

        let bodyHtml = '';
        if (card.body_md) bodyHtml += `<div class="card-md">${marked.parse(card.body_md)}</div>`;
        if (card.starter_json) {
          bodyHtml += `<button class="try-it-btn" onclick="tryCard('${card.code}')">Try it</button>`;
        }
        document.getElementById('drawer-body').innerHTML = bodyHtml || '<p class="drawer-loading">No content yet.</p>';
      } catch {
        document.getElementById('drawer-body').innerHTML = '<p class="drawer-error">Could not load this card.</p>';
      }
    }

    function closeDrawer() {
      activeCardCode = null;
      const drawer = document.getElementById('card-drawer');
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
    }

    function toggleDrawer() {
      const drawer = document.getElementById('card-drawer');
      if (drawer.classList.contains('open')) {
        closeDrawer();
      } else if (initialCardCode) {
        openCard(initialCardCode);
      }
    }

    async function tryCard(code) {
      const btn = document.querySelector('.try-it-btn');
      if (btn) { btn.disabled = true; btn.textContent = 'Opening…'; }
      try {
        const res = await fetch(`/projects/try/${code}`, { method: 'POST' });
        if (!res.ok) throw new Error('Failed');
        const data = await res.json();
        window.location.href = `/projects/${data.projectId}?card=${code}`;
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = 'Try it'; }
        alert('Something went wrong. Please try again.');
      }
    }

    // Keyboard: Escape closes whichever overlay is open (menu modal first)
    document.addEventListener('keydown', e => {
      if (e.key !== 'Escape') return;
      const menuOverlay = document.getElementById('menu-modal-overlay');
      if (menuOverlay && menuOverlay.classList.contains('open')) { e.preventDefault(); closeMenuModal(); return; }
      const drawer = document.getElementById('card-drawer');
      if (drawer.classList.contains('open')) { e.preventDefault(); closeDrawer(); }
    });

    // ── Monaco setup ──
    require.config({ paths: { vs: 'https://cdn.jsdelivr.net/npm/monaco-editor@0.45.0/min/vs' } });
    require(['vs/editor/editor.main'], function () {
      editor = monaco.editor.create(document.getElementById('monaco-container'), {
        theme: 'vs-dark',
        fontSize: 14,
        minimap: { enabled: false },
        automaticLayout: true,
        scrollBeyondLastLine: false,
        wordWrap: 'on',
        readOnly: READONLY,
        model: null,
      });

      // Create a Monaco model for each file
      for (const f of files) {
        const model = monaco.editor.createModel(f.content, langFromPath(f.path));
        models[f.id] = model;
        if (!READONLY) {
          model.onDidChangeContent(() => {
            scheduleAutosave(f.id);
            schedulePreviewRefresh();
          });
        }
      }

      // Render tabs and activate first file (prefer index.html)
      renderTabs();
      const preferred = files.find(f => f.path === 'index.html') || files[0];
      if (preferred) switchToFile(preferred.id);

      // Initial preview (immediate, no debounce)
      refreshPreview();

      // Auto-open card drawer if we arrived from "Try it"
      if (initialCardCode) openCard(initialCardCode);
    });
  </script>
</body>
</html>
