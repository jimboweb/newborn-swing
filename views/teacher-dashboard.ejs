<body>
  <nav>
    <h1>Newborn Swing <span class="badge">Teacher</span></h1>
    <span><%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>
  <h2>Teacher Dashboard</h2>
  <p>Problem management and submission review coming in later phases.</p>
</body>
</html>
