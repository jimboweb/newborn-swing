<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Roster — Newborn Swing</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: sans-serif; max-width: 860px; margin: 40px auto; padding: 0 1rem; }
    nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    h1 { font-size: 1.4rem; margin: 0; }
    .badge { background: #27ae60; color: #fff; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
    .back { color: #555; text-decoration: none; font-size: 0.9rem; }
    .back:hover { color: #000; }
    h2 { font-size: 1.1rem; margin: 1rem 0 0.25rem; }
    .subtitle { color: #888; font-size: 0.85rem; margin-bottom: 1.5rem; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 0.65rem 0.75rem; border-bottom: 1px solid #e0e0e0; }
    th { background: #f5f5f5; font-size: 0.85rem; color: #555; }
    td { font-size: 0.9rem; }
    .email { color: #888; font-size: 0.8rem; }
    .stat { font-weight: 600; }
    .joined { color: #aaa; font-size: 0.8rem; }
    .empty { color: #888; padding: 2rem 0; text-align: center; }
  </style>
</head>
<body>
  <nav>
    <h1>Newborn Swing <span class="badge">Teacher</span></h1>
    <span><%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>

  <a href="/dashboard" class="back">← Back to Dashboard</a>
  <h2>Student Roster</h2>
  <p class="subtitle"><%= students.length %> student<%= students.length !== 1 ? 's' : '' %> registered</p>

  <% if (students.length === 0) { %>
    <p class="empty">No students have signed in yet.</p>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Name</th>
          <th>Email</th>
          <th>Problems Attempted</th>
          <th>Problems Completed</th>
          <th>Joined</th>
        </tr>
      </thead>
      <tbody>
        <% students.forEach(s => { %>
          <tr>
            <td><strong><%= s.name %></strong></td>
            <td class="email"><%= s.email %></td>
            <td class="stat"><%= s.problems_attempted %></td>
            <td class="stat"><%= s.problems_passed %></td>
            <td class="joined"><%= new Date(s.created_at).toLocaleDateString() %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</body>
</html>
