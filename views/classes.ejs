<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Classes — Newborn Swing</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: sans-serif; max-width: 760px; margin: 40px auto; padding: 0 1rem; }
    nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    h1 { font-size: 1.4rem; margin: 0; }
    .badge { background: #27ae60; color: #fff; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
    .back { color: #555; text-decoration: none; font-size: 0.9rem; }
    .back:hover { color: #000; }
    h2 { font-size: 1.1rem; margin: 1rem 0 1rem; }
    .new-form { display: flex; gap: 0.5rem; margin-bottom: 2rem; }
    .new-form input { flex: 1; padding: 0.5rem 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem; }
    .btn { display: inline-block; padding: 0.45rem 1rem; border-radius: 4px; font-size: 0.9rem; cursor: pointer; text-decoration: none; border: none; }
    .btn-primary { background: #2980b9; color: #fff; }
    .btn-primary:hover { background: #2471a3; }
    .btn-delete { background: #c0392b; color: #fff; font-size: 0.8rem; padding: 0.3rem 0.7rem; }
    .btn-delete:hover { background: #a93226; }
    .class-card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem 1.25rem; margin-bottom: 0.75rem; display: flex; justify-content: space-between; align-items: center; }
    .class-name { font-weight: 600; }
    .class-meta { font-size: 0.82rem; color: #888; margin-top: 0.2rem; }
    .class-actions { display: flex; gap: 0.5rem; align-items: center; }
    .btn-manage { background: #16a085; color: #fff; font-size: 0.8rem; padding: 0.3rem 0.7rem; text-decoration: none; border-radius: 4px; }
    .btn-manage:hover { background: #138d75; }
    .empty { color: #888; font-style: italic; }
  </style>
</head>
<body>
  <nav>
    <h1>Newborn Swing <span class="badge">Teacher</span></h1>
    <span><%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>

  <a href="/dashboard" class="back">← Back to Dashboard</a>
  <h2>Classes</h2>

  <form class="new-form" method="POST" action="/classes">
    <input type="text" name="name" placeholder="New class name (e.g. Period 1)" required>
    <button type="submit" class="btn btn-primary">Create</button>
  </form>

  <% if (classes.length === 0) { %>
    <p class="empty">No classes yet.</p>
  <% } else { %>
    <% classes.forEach(c => { %>
      <div class="class-card">
        <div>
          <div class="class-name"><%= c.name %></div>
          <div class="class-meta"><%= c.member_count %> student<%= c.member_count != 1 ? 's' : '' %></div>
        </div>
        <div class="class-actions">
          <a href="/classes/<%= c.id %>" class="btn-manage">Manage</a>
          <form method="POST" action="/classes/<%= c.id %>/delete" onsubmit="return confirm('Delete this class?')">
            <button type="submit" class="btn btn-delete">Delete</button>
          </form>
        </div>
      </div>
    <% }) %>
  <% } %>
</body>
</html>
