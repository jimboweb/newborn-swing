<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Checkpoint Cards — Newborn Swing</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: sans-serif;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      background: #f7f7f8;
    }

    /* ── Top nav ── */
    .topnav {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 0.6rem 1.25rem;
      background: #fff;
      border-bottom: 1px solid #e0e0e0;
      flex-shrink: 0;
      gap: 1rem;
    }
    .topnav-left { display: flex; align-items: center; gap: 1rem; }
    .topnav h1 { font-size: 1rem; font-weight: 700; color: #111; white-space: nowrap; }
    .back-link { font-size: 0.85rem; color: #2980b9; text-decoration: none; white-space: nowrap; }
    .back-link:hover { text-decoration: underline; }
    .topnav-right { font-size: 0.85rem; color: #555; white-space: nowrap; }
    .topnav-right a { color: #555; text-decoration: none; }
    .topnav-right a:hover { text-decoration: underline; }

    /* ── Layout: drawer + ladder ── */
    .layout {
      display: flex;
      flex: 1;
      overflow: hidden;
    }

    /* ── Card drawer ── */
    .card-drawer {
      width: 0;
      overflow: hidden;
      background: #fff;
      border-right: 1px solid #e0e0e0;
      flex-shrink: 0;
      transition: width 0.22s ease;
      display: flex;
      flex-direction: column;
    }
    .card-drawer.open { width: 420px; }

    .drawer-inner {
      width: 420px;
      height: 100%;
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }

    .drawer-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      padding: 1rem 1.25rem 0.75rem;
      border-bottom: 1px solid #e8e8e8;
      flex-shrink: 0;
      gap: 0.75rem;
    }
    .drawer-header-text { flex: 1; min-width: 0; }
    .drawer-code { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; color: #888; text-transform: uppercase; margin-bottom: 0.2rem; }
    .drawer-title { font-size: 1.05rem; font-weight: 700; color: #111; line-height: 1.3; }

    .close-btn {
      background: none;
      border: 1px solid #ccc;
      border-radius: 4px;
      width: 28px;
      height: 28px;
      font-size: 1.1rem;
      line-height: 1;
      cursor: pointer;
      color: #555;
      flex-shrink: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .close-btn:hover { background: #f0f0f0; }

    .drawer-body {
      flex: 1;
      overflow-y: auto;
      padding: 1.25rem;
    }

    /* ── Rendered markdown inside drawer ── */
    .card-md h2 { font-size: 1rem; font-weight: 700; margin: 1.25rem 0 0.5rem; color: #111; }
    .card-md h2:first-child { margin-top: 0; }
    .card-md h3 { font-size: 0.92rem; font-weight: 700; margin: 1rem 0 0.35rem; color: #333; }
    .card-md p { font-size: 0.92rem; line-height: 1.6; color: #222; margin-bottom: 0.75rem; }
    .card-md ul, .card-md ol { padding-left: 1.4rem; margin-bottom: 0.75rem; }
    .card-md li { font-size: 0.92rem; line-height: 1.6; color: #222; margin-bottom: 0.25rem; }
    .card-md code { background: #f0f0f0; padding: 0.1em 0.35em; border-radius: 3px; font-size: 0.88em; font-family: monospace; color: #c7254e; }
    .card-md pre { background: #f5f5f5; border: 1px solid #e0e0e0; border-radius: 4px; padding: 0.75rem 1rem; overflow-x: auto; margin-bottom: 0.75rem; }
    .card-md pre code { background: none; padding: 0; color: #222; font-size: 0.85rem; }
    .card-md strong { font-weight: 700; }
    .card-md blockquote { border-left: 3px solid #ccc; padding-left: 0.75rem; color: #555; margin-bottom: 0.75rem; }
    .card-md hr { border: none; border-top: 1px solid #e0e0e0; margin: 1rem 0; }

    .drawer-loading { color: #888; font-size: 0.9rem; padding: 2rem 1.25rem; }
    .drawer-error   { color: #c0392b; font-size: 0.9rem; padding: 2rem 1.25rem; }

    /* ── Ladder panel ── */
    .ladder {
      flex: 1;
      overflow-y: auto;
      padding: 1.5rem;
    }

    .search-row {
      margin-bottom: 1.5rem;
    }
    .search-input {
      width: 100%;
      max-width: 420px;
      padding: 0.5rem 0.85rem;
      font-size: 0.95rem;
      border: 1px solid #ccc;
      border-radius: 6px;
      background: #fff;
      color: #111;
      outline: none;
    }
    .search-input:focus { border-color: #2980b9; box-shadow: 0 0 0 3px rgba(41,128,185,0.15); }

    /* ── Trunk section ── */
    .branch-group { margin-bottom: 2rem; }
    .branch-heading {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #888;
      margin-bottom: 0.6rem;
      padding-bottom: 0.4rem;
      border-bottom: 1px solid #e4e4e4;
    }

    /* ── Direction separator ── */
    .direction-sep {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin: 1.75rem 0 1.25rem;
      color: #aaa;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.08em;
    }
    .direction-sep::before,
    .direction-sep::after { content: ''; flex: 1; border-top: 1px solid #e0e0e0; }

    /* ── Branch columns ── */
    .branches-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 1.25rem;
      align-items: start;
    }
    @media (max-width: 680px) {
      .branches-grid { grid-template-columns: 1fr; }
    }
    .branch-col-heading {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: #555;
      margin-bottom: 0.75rem;
      padding-bottom: 0.4rem;
      border-bottom: 2px solid #e0e0e0;
    }
    .depth-group { margin-bottom: 0.9rem; }
    .depth-heading {
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: #bbb;
      margin-bottom: 0.35rem;
      margin-top: 0.5rem;
    }

    .prereq-notice {
      font-size: 0.82rem;
      color: #888;
      margin-bottom: 1rem;
      padding: 0.4rem 0.7rem;
      background: #f7f7f8;
      border-radius: 4px;
      border-left: 3px solid #ccc;
    }
    .prereq-notice a { color: #2980b9; text-decoration: none; }
    .prereq-notice a:hover { text-decoration: underline; }

    /* ── Try it button ── */
    .try-it-btn {
      display: block;
      margin-top: 1.25rem;
      width: 100%;
      padding: 0.6rem 1rem;
      background: #2980b9;
      color: #fff;
      border: none;
      border-radius: 5px;
      font-size: 0.95rem;
      font-weight: 600;
      cursor: pointer;
    }
    .try-it-btn:hover:not(:disabled) { background: #2471a3; }
    .try-it-btn:disabled { opacity: 0.6; cursor: default; }

    /* ── Checkpoint rows ── */
    .checkpoint-item {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.7rem 0.9rem;
      border: 1px solid #e4e4e4;
      border-radius: 7px;
      margin-bottom: 0.45rem;
      background: #fff;
      cursor: pointer;
      transition: border-color 0.12s, box-shadow 0.12s, background 0.12s;
      text-align: left;
      width: 100%;
    }
    .checkpoint-item:hover {
      border-color: #2980b9;
      box-shadow: 0 0 0 3px rgba(41,128,185,0.1);
    }
    .checkpoint-item.active {
      border-color: #2980b9;
      background: #f0f7ff;
    }
    .checkpoint-item.no-card {
      opacity: 0.5;
      cursor: default;
    }
    .checkpoint-item.no-card:hover {
      border-color: #e4e4e4;
      box-shadow: none;
    }
    .checkpoint-item.hidden { display: none; }

    .cp-code {
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      color: #888;
      white-space: nowrap;
      min-width: 2.8rem;
    }
    .cp-title {
      flex: 1;
      font-size: 0.95rem;
      font-weight: 600;
      color: #111;
    }
    .cp-finish {
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: #27ae60;
      background: #eafaf1;
      border: 1px solid #a9dfbf;
      border-radius: 10px;
      padding: 0.15rem 0.55rem;
      white-space: nowrap;
    }
    .cp-arrow {
      color: #bbb;
      font-size: 0.85rem;
    }
    .cp-coming {
      font-size: 0.75rem;
      color: #bbb;
      font-style: italic;
    }

    /* ── Progress state badges ── */
    .state-badge {
      font-size: 0.68rem;
      font-weight: 600;
      padding: 0.1rem 0.45rem;
      border-radius: 10px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .state-in-progress { background: #dbeafe; color: #1e40af; }
    .state-self-checked { background: #fef3c7; color: #92400e; }
    .state-confirmed    { background: #d1fae5; color: #065f46; }

    /* ── Drawer state footer ── */
    .drawer-state {
      border-top: 1px solid #e8e8e8;
      padding: 0.9rem 0 0.2rem;
      margin-top: 1.25rem;
    }
    .drawer-state-label {
      font-size: 0.78rem;
      color: #888;
      margin-bottom: 0.5rem;
    }
    .drawer-state-label strong { color: #333; }
    .state-advance-btn {
      display: block;
      width: 100%;
      padding: 0.5rem 1rem;
      border: 1px solid #2980b9;
      border-radius: 5px;
      background: #fff;
      color: #2980b9;
      font-size: 0.88rem;
      font-weight: 600;
      cursor: pointer;
      text-align: center;
    }
    .state-advance-btn:hover { background: #f0f7ff; }
    .state-advance-btn:disabled { opacity: 0.5; cursor: default; }
    .state-waiting  { font-size: 0.85rem; color: #92400e; }
    .state-done     { font-size: 0.85rem; color: #065f46; font-weight: 600; }
    .state-needs-work { font-size: 0.85rem; color: #9a3412; }
    .teacher-note-box {
      background: #fff7ed; border: 1px solid #fdba74; border-radius: 5px;
      padding: 0.6rem 0.75rem; margin-bottom: 0.6rem;
      font-size: 0.85rem; color: #9a3412; line-height: 1.5;
    }
    .teacher-note-label { font-weight: 700; margin-bottom: 0.2rem; }
    .doc-input {
      width: 100%; padding: 0.4rem 0.6rem; border: 1px solid #ccc; border-radius: 4px;
      font-size: 0.85rem; margin-bottom: 0.4rem;
    }
    .doc-input:focus { outline: none; border-color: #2980b9; }
    .doc-hint { font-size: 0.75rem; color: #888; margin-bottom: 0.6rem; }

    /* ── Video embed ── */
    .card-video {
      position: relative; padding-bottom: 56.25%; height: 0;
      margin-bottom: 1rem; border-radius: 6px; overflow: hidden; background: #000;
    }
    .card-video iframe { position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; }
    .card-video-link { margin-bottom: 0.75rem; }
    .card-video-link a {
      display: inline-flex; align-items: center; gap: 0.4rem;
      color: #2980b9; text-decoration: none; font-size: 0.9rem; font-weight: 600;
      border: 1px solid #2980b9; border-radius: 4px; padding: 0.35rem 0.75rem;
    }
    .card-video-link a:hover { background: #f0f7ff; }
    .card-md img { max-width: 100%; border-radius: 4px; margin: 0.5rem 0; display: block; }
    .card-md a { color: #2980b9; }

    /* ── Teacher edit link ── */
    .edit-card-link {
      display: inline-block; margin-bottom: 0.75rem;
      font-size: 0.78rem; color: #888; text-decoration: none;
      border: 1px solid #ddd; border-radius: 4px; padding: 0.2rem 0.6rem;
    }
    .edit-card-link:hover { background: #f5f5f5; color: #333; }

    /* No-results message */
    .no-results {
      color: #888;
      font-size: 0.9rem;
      font-style: italic;
      padding: 0.5rem 0;
    }

    @media (max-width: 700px) {
      .card-drawer.open { width: 100vw; }
      .drawer-inner { width: 100vw; }
    }
  </style>
</head>
<body>
  <nav class="topnav">
    <div class="topnav-left">
      <h1>Newborn Swing</h1>
      <a href="/dashboard" class="back-link">&#8592; Dashboard</a>
      <% if (user.role === 'teacher') { %>
        <a href="/admin/ladder" class="back-link">&#9998; Ladder Editor</a>
      <% } %>
    </div>
    <span class="topnav-right"><%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>

  <div class="layout">
    <!-- Card drawer (slides in from left) -->
    <aside class="card-drawer" id="card-drawer" aria-label="Card content" aria-hidden="true">
      <div class="drawer-inner">
        <div class="drawer-header" id="drawer-header">
          <div class="drawer-header-text">
            <div class="drawer-code" id="drawer-code"></div>
            <div class="drawer-title" id="drawer-title"></div>
          </div>
          <button class="close-btn" id="close-btn" aria-label="Close card" onclick="closeDrawer()">&#x2715;</button>
        </div>
        <div class="drawer-body" id="drawer-body">
          <p class="drawer-loading" id="drawer-placeholder">Select a checkpoint to read its card.</p>
        </div>
      </div>
    </aside>

    <!-- Checkpoint ladder -->
    <main class="ladder" id="ladder">
      <div class="search-row">
        <input
          type="search"
          class="search-input"
          id="search-input"
          placeholder="Search checkpoints..."
          aria-label="Search checkpoints"
          autocomplete="off"
        >
      </div>

      <%
        const trunk       = checkpoints.filter(cp => cp.branch === 'trunk');
        const lastTrunk   = trunk[trunk.length - 1];
        const branchGroups = [
          { key: 'visual',      label: 'Visual',      cps: checkpoints.filter(cp => cp.branch === 'visual') },
          { key: 'interactive', label: 'Interactive',  cps: checkpoints.filter(cp => cp.branch === 'interactive') },
          { key: 'data',        label: 'Data',         cps: checkpoints.filter(cp => cp.branch === 'data') },
        ].filter(b => b.cps.length);

        function cpRow(cp, isFinish) {
          const hasCard  = cp.card_id != null;
          const keywords = Array.isArray(cp.keywords) ? cp.keywords.join(' ') : '';
          const cpState  = progress[cp.code] ? progress[cp.code].state : null;
          const clickable = hasCard || user.role === 'teacher';
          const cls = 'checkpoint-item' + (clickable ? '' : ' no-card');
          const attrs = clickable
            ? `onclick="openCard('${cp.code}')"`
            : 'disabled';
          let inner = `<span class="cp-code">${cp.code}</span><span class="cp-title">${cp.title}</span>`;
          if (isFinish)                       inner += `<span class="cp-finish">Finish line</span>`;
          if (!hasCard)                       inner += `<span class="cp-coming">Card coming soon</span>`;
          if (cpState === 'in_progress')      inner += `<span class="state-badge state-in-progress">Started</span>`;
          if (cpState === 'self_checked')     inner += `<span class="state-badge state-self-checked">Self-checked</span>`;
          if (cpState === 'needs_work')       inner += `<span class="state-badge" style="background:#fee2e2;color:#991b1b">Needs work</span>`;
          if (cpState === 'confirmed')        inner += `<span class="state-badge state-confirmed">Confirmed ✓</span>`;
          if (hasCard && !cpState)            inner += `<span class="cp-arrow">›</span>`;
          return `<button class="${cls}" data-code="${cp.code}" data-title="${cp.title}" data-keywords="${keywords}" aria-label="${cp.code}: ${cp.title}" ${attrs}>${inner}</button>`;
        }
      %>

      <div class="branch-group" data-branch="trunk">
        <div class="branch-heading">Trunk</div>
        <%- trunk.map(cp => cpRow(cp, cp === lastTrunk)).join('') %>
      </div>

      <% if (branchGroups.length) { %>
        <div class="direction-sep">choose a direction, or mix</div>
        <div class="branches-grid" id="branches-grid">
        <% for (const bg of branchGroups) { %>
          <%
            const DEPTH_LABELS = { 1: 'Start here', 2: 'Going deeper', 3: 'Deepest' };
            const byDepth = {};
            for (const cp of bg.cps) {
              const d = cp.depth ?? 1;
              if (!byDepth[d]) byDepth[d] = [];
              byDepth[d].push(cp);
            }
            const depthKeys = Object.keys(byDepth).map(Number).sort();
          %>
          <div class="branch-col" data-branch="<%= bg.key %>">
            <div class="branch-col-heading"><%= bg.label %></div>
            <% for (const d of depthKeys) { %>
              <div class="depth-group" data-depth="<%= d %>">
                <% if (depthKeys.length > 1) { %>
                  <div class="depth-heading"><%= DEPTH_LABELS[d] || 'Depth ' + d %></div>
                <% } %>
                <%- byDepth[d].map(cp => cpRow(cp, false)).join('') %>
              </div>
            <% } %>
          </div>
        <% } %>
        </div>
      <% } %>

      <p class="no-results" id="no-results" style="display:none">No checkpoints match your search.</p>
    </main>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/marked@9/marked.min.js"></script>
  <script>
    const drawer      = document.getElementById('card-drawer');
    const drawerCode  = document.getElementById('drawer-code');
    const drawerTitle = document.getElementById('drawer-title');
    const drawerBody  = document.getElementById('drawer-body');
    const searchInput = document.getElementById('search-input');
    const noResults   = document.getElementById('no-results');

    <% if (user.role === 'student') { %>
    let progressMap = <%- JSON.stringify(progress).replace(/<\//g, '<\\/') %>;
    <% } else { %>
    const progressMap = null;
    <% } %>
    const isTeacher = <%= user.role === 'teacher' %>;
    const allCheckpoints = <%- JSON.stringify(checkpoints.map(cp => ({ code: cp.code, needs: cp.needs || [] }))).replace(/<\//g, '<\\/') %>;

    function toEmbedUrl(url) {
      if (!url) return null;
      let m = url.match(/[?&]v=([a-zA-Z0-9_-]{11})/);
      if (m) return `https://www.youtube.com/embed/${m[1]}`;
      m = url.match(/youtu\.be\/([a-zA-Z0-9_-]{11})/);
      if (m) return `https://www.youtube.com/embed/${m[1]}`;
      if (/youtube\.com\/embed\//.test(url)) return url;
      m = url.match(/vimeo\.com\/(\d+)/);
      if (m) return `https://player.vimeo.com/video/${m[1]}`;
      if (/player\.vimeo\.com\/video\//.test(url)) return url;
      return null;
    }

    let activeCode = null;

    function stateFooterHtml(code) {
      if (!progressMap) return '';
      const entry = progressMap[code] || { state: 'not_started', doc_url: null, teacher_note: null };
      const { state, doc_url, teacher_note } = entry;
      const labels = {
        not_started: 'Not started', in_progress: 'Started',
        self_checked: 'Ready for review', needs_work: 'Needs work', confirmed: 'Confirmed',
      };
      let action = '';
      if (state === 'not_started') {
        action = `<button class="state-advance-btn" onclick="advanceState('${code}','in_progress')">Mark as started</button>`;
      } else if (state === 'in_progress') {
        action = `<button class="state-advance-btn" onclick="showDocForm('${code}')">I've completed the self-check</button>`;
      } else if (state === 'self_checked') {
        action = `<p class="state-waiting">Ready for your teacher to check in.</p>`;
      } else if (state === 'needs_work') {
        const noteHtml = teacher_note
          ? `<div class="teacher-note-box"><div class="teacher-note-label">From your teacher:</div>${escHtml(teacher_note)}</div>`
          : '';
        action = `${noteHtml}<button class="state-advance-btn" onclick="showDocForm('${code}','${escAttr(doc_url || '')}')">Update and resubmit</button>`;
      } else if (state === 'confirmed') {
        action = `<p class="state-done">&#10003; Confirmed by your teacher</p>`;
      }
      return `<div class="drawer-state">
        <p class="drawer-state-label">Your status: <strong>${labels[state] || state}</strong></p>
        ${action}
      </div>`;
    }

    function escHtml(s) {
      return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
    }
    function escAttr(s) {
      return s.replace(/'/g,'&#39;').replace(/"/g,'&quot;');
    }

    function showDocForm(code, existingUrl) {
      const stateEl = drawerBody.querySelector('.drawer-state');
      if (!stateEl) return;
      stateEl.innerHTML = `
        <p class="drawer-state-label">Google Doc link <span style="font-weight:400;color:#888">(optional)</span>:</p>
        <p class="doc-hint">If your work is a Google Doc, paste the link here and make sure sharing is set to "Anyone with the link." Leave blank if your work is in the HTML editor.</p>
        <input class="doc-input" id="doc-url-input" type="url"
          placeholder="https://docs.google.com/... (or leave blank)"
          value="${escAttr(existingUrl || '')}">
        <button class="state-advance-btn" onclick="submitSelfCheck('${code}')">Submit for review</button>
        <button class="state-advance-btn" onclick="cancelDocForm('${code}')"
          style="background:#fff;color:#666;border-color:#ccc;margin-top:0.3rem">Cancel</button>
      `;
    }

    function cancelDocForm(code) {
      const stateEl = drawerBody.querySelector('.drawer-state');
      if (stateEl) stateEl.outerHTML = stateFooterHtml(code);
    }

    async function submitSelfCheck(code) {
      const input = document.getElementById('doc-url-input');
      const doc_url = input ? input.value.trim() : '';

      const btn = drawerBody.querySelector('.state-advance-btn');
      if (btn) { btn.disabled = true; btn.textContent = 'Submitting…'; }
      try {
        const res = await fetch(`/api/progress/${code}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ state: 'self_checked', doc_url }),
        });
        if (!res.ok) throw new Error('Failed');
        progressMap[code] = { state: 'self_checked', doc_url, teacher_note: null };
        updateLadderBadge(code, 'self_checked');
        const stateEl = drawerBody.querySelector('.drawer-state');
        if (stateEl) stateEl.outerHTML = stateFooterHtml(code);
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = 'Submit for review'; }
        alert('Something went wrong. Please try again.');
      }
    }

    async function advanceState(code, newState) {
      const btn = drawerBody.querySelector('.state-advance-btn');
      if (btn) { btn.disabled = true; btn.textContent = 'Saving…'; }
      try {
        const res = await fetch(`/api/progress/${code}`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ state: newState }),
        });
        if (!res.ok) throw new Error('Failed');
        if (!progressMap[code]) progressMap[code] = {};
        progressMap[code].state = newState;
        updateLadderBadge(code, newState);
        const stateEl = drawerBody.querySelector('.drawer-state');
        if (stateEl) stateEl.outerHTML = stateFooterHtml(code);
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = 'Try again'; }
      }
    }

    function updateLadderBadge(code, state) {
      const row = document.querySelector(`[data-code="${code}"]`);
      if (!row) return;
      row.querySelectorAll('.state-badge, .cp-arrow').forEach(el => el.remove());
      if (state === 'in_progress') {
        row.insertAdjacentHTML('beforeend', '<span class="state-badge state-in-progress">Started</span>');
      } else if (state === 'self_checked') {
        row.insertAdjacentHTML('beforeend', '<span class="state-badge state-self-checked">Self-checked</span>');
      } else if (state === 'needs_work') {
        row.insertAdjacentHTML('beforeend', '<span class="state-badge" style="background:#fee2e2;color:#991b1b">Needs work</span>');
      } else if (state === 'confirmed') {
        row.insertAdjacentHTML('beforeend', '<span class="state-badge state-confirmed">Confirmed ✓</span>');
      } else {
        row.insertAdjacentHTML('beforeend', '<span class="cp-arrow">›</span>');
      }
    }

    async function openCard(code) {
      if (activeCode === code) { closeDrawer(); return; }

      // Mark active row
      document.querySelectorAll('.checkpoint-item').forEach(el => el.classList.remove('active'));
      const btn = document.querySelector(`[data-code="${code}"]`);
      if (btn) btn.classList.add('active');

      // Open drawer immediately with loading state
      activeCode = code;
      drawerCode.textContent = code;
      drawerTitle.textContent = btn ? btn.dataset.title : '';
      drawerBody.innerHTML = '<p class="drawer-loading">Loading…</p>';
      drawer.classList.add('open');
      drawer.setAttribute('aria-hidden', 'false');

      try {
        const res = await fetch(`/cards/data/${code}`);
        if (!res.ok) throw new Error('Card not found');
        const card = await res.json();

        drawerCode.textContent  = card.code;
        drawerTitle.textContent = card.title;

        let bodyHtml = '';

        if (isTeacher) {
          bodyHtml += `<a href="/admin/cards/${card.code}" class="edit-card-link">&#9998; Edit this card</a>`;
        }

        // Prereq notice
        const cpMeta = allCheckpoints.find(c => c.code === card.code);
        const needs  = cpMeta ? cpMeta.needs : [];
        const unmet  = needs.filter(n => !progressMap || !progressMap[n] || progressMap[n].state !== 'confirmed');
        if (unmet.length) {
          const links = unmet.map(n => `<a href="#" onclick="openCard('${n}');return false;">${n}</a>`).join(', ');
          bodyHtml += `<div class="prereq-notice">Needs ${links} first.</div>`;
        }

        if (card.video_url) {
          const embed = toEmbedUrl(card.video_url);
          if (embed) {
            bodyHtml += `<div class="card-video"><iframe src="${embed}" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe></div>`;
          } else {
            bodyHtml += `<div class="card-video-link"><a href="${card.video_url}" target="_blank" rel="noopener">&#9654; Watch video</a></div>`;
          }
        }

        if (card.body_md) bodyHtml += `<div class="card-md">${marked.parse(card.body_md)}</div>`;
        if (card.starter_json) {
          bodyHtml += `<button class="try-it-btn" onclick="tryCard('${card.code}')">Try it</button>`;
        }
        bodyHtml += stateFooterHtml(code);
        if (!bodyHtml.trim()) {
          bodyHtml = isTeacher
            ? `<a href="/admin/cards/${card.code}" class="edit-card-link">&#9998; Create card content</a>`
            : '<p class="drawer-loading">This card has no content yet.</p>';
        }
        drawerBody.innerHTML = bodyHtml;
      } catch (err) {
        drawerBody.innerHTML = '<p class="drawer-error">Could not load this card. Try again.</p>';
      }
    }

    async function tryCard(code) {
      const btn = drawerBody.querySelector('.try-it-btn');
      if (btn) { btn.disabled = true; btn.textContent = 'Opening…'; }
      try {
        const res = await fetch(`/projects/try/${code}`, { method: 'POST' });
        if (!res.ok) throw new Error('Failed');
        const data = await res.json();
        window.location.href = `/projects/${data.projectId}?card=${code}`;
      } catch {
        if (btn) { btn.disabled = false; btn.textContent = 'Try it'; }
        alert('Something went wrong. Please try again.');
      }
    }

    function closeDrawer() {
      drawer.classList.remove('open');
      drawer.setAttribute('aria-hidden', 'true');
      document.querySelectorAll('.checkpoint-item').forEach(el => el.classList.remove('active'));
      activeCode = null;
    }

    // Keyboard: Escape closes drawer
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && drawer.classList.contains('open')) closeDrawer();
    });

    // Search: filter checkpoint rows by title, code, and keywords
    searchInput.addEventListener('input', () => {
      const q = searchInput.value.trim().toLowerCase();
      let visible = 0;

      document.querySelectorAll('.checkpoint-item').forEach(btn => {
        const haystack = [
          btn.dataset.code,
          btn.dataset.title,
          btn.dataset.keywords,
        ].join(' ').toLowerCase();

        const show = !q || haystack.includes(q);
        btn.classList.toggle('hidden', !show);
        if (show) visible++;
      });

      noResults.style.display = visible === 0 ? '' : 'none';

      // Trunk: hide section if nothing visible
      const trunkGroup = document.querySelector('.branch-group[data-branch="trunk"]');
      if (trunkGroup) {
        trunkGroup.style.display = [...trunkGroup.querySelectorAll('.checkpoint-item')]
          .some(b => !b.classList.contains('hidden')) ? '' : 'none';
      }

      // Branches: hide depth groups, then columns, then the whole grid + separator
      document.querySelectorAll('.depth-group').forEach(dg => {
        dg.style.display = [...dg.querySelectorAll('.checkpoint-item')]
          .some(b => !b.classList.contains('hidden')) ? '' : 'none';
      });
      document.querySelectorAll('.branch-col').forEach(col => {
        col.style.display = [...col.querySelectorAll('.checkpoint-item')]
          .some(b => !b.classList.contains('hidden')) ? '' : 'none';
      });
      const grid = document.getElementById('branches-grid');
      const sep  = document.querySelector('.direction-sep');
      if (grid) {
        const anyBranch = [...grid.querySelectorAll('.checkpoint-item')]
          .some(b => !b.classList.contains('hidden'));
        grid.style.display = anyBranch ? '' : 'none';
        if (sep) sep.style.display = anyBranch ? '' : 'none';
      }
    });
  </script>
</body>
</html>