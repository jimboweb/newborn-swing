<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= cls.name %> — Newborn Swing</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; }
    body { font-family: sans-serif; max-width: 760px; margin: 40px auto; padding: 0 1rem; }
    nav { display: flex; justify-content: space-between; align-items: center; margin-bottom: 2rem; }
    h1 { font-size: 1.4rem; margin: 0; }
    .badge { background: #27ae60; color: #fff; padding: 0.2rem 0.5rem; border-radius: 4px; font-size: 0.75rem; }
    .back { color: #555; text-decoration: none; font-size: 0.9rem; }
    .back:hover { color: #000; }
    h2 { font-size: 1.1rem; margin: 1rem 0 0.75rem; }
    .add-form { display: flex; gap: 0.5rem; margin-bottom: 1.5rem; }
    .add-form select { flex: 1; padding: 0.5rem 0.6rem; border: 1px solid #ccc; border-radius: 4px; font-size: 0.9rem; }
    .btn { display: inline-block; padding: 0.45rem 1rem; border-radius: 4px; font-size: 0.9rem; cursor: pointer; text-decoration: none; border: none; }
    .btn-primary { background: #2980b9; color: #fff; }
    .btn-primary:hover { background: #2471a3; }
    .btn-remove { background: none; border: none; color: #c0392b; font-size: 0.82rem; cursor: pointer; padding: 0; }
    .btn-remove:hover { text-decoration: underline; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 0.6rem 0.75rem; border-bottom: 1px solid #e0e0e0; font-size: 0.9rem; }
    th { background: #f5f5f5; font-size: 0.82rem; color: #555; }
    .empty { color: #888; font-style: italic; padding: 1rem 0; }
    .sub { font-size: 0.8rem; color: #888; }
  </style>
</head>
<body>
  <nav>
    <h1>Newborn Swing <span class="badge">Teacher</span></h1>
    <span><%= user.name %> &nbsp;|&nbsp; <a href="/auth/logout">Sign out</a></span>
  </nav>

  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem">
    <a href="/classes" class="back">← Back to Classes</a>
    <a href="/classes/<%= cls.id %>/grid" style="display:inline-block;padding:0.35rem 0.9rem;background:#16a085;color:#fff;border-radius:4px;font-size:0.85rem;text-decoration:none;font-weight:600">Progress Grid</a>
  </div>
  <h2><%= cls.name %></h2>

  <% if (nonMembers.length > 0) { %>
    <form class="add-form" method="POST" action="/classes/<%= cls.id %>/members/add">
      <select name="student_id" required>
        <option value="">Add a student…</option>
        <% nonMembers.forEach(s => { %>
          <option value="<%= s.id %>"><%= s.name %> (<%= s.email %>)</option>
        <% }) %>
      </select>
      <button type="submit" class="btn btn-primary">Add</button>
    </form>
  <% } %>

  <% if (members.length === 0) { %>
    <p class="empty">No students in this class yet.</p>
  <% } else { %>
    <table>
      <thead>
        <tr><th>Name</th><th>Email</th><th></th></tr>
      </thead>
      <tbody>
        <% members.forEach(m => { %>
          <tr>
            <td><strong><%= m.name %></strong></td>
            <td class="sub"><%= m.email %></td>
            <td>
              <form method="POST" action="/classes/<%= cls.id %>/members/<%= m.id %>/remove">
                <button type="submit" class="btn-remove">Remove</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</body>
</html>
